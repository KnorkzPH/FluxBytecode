    end)

    local Section = MainTab:Section({ Title = "Appliances" })

    if not (GetApplianceData and BuyAppliance and okCfg and type(ApplianceConfig) == "table" and ApplianceConfig.Items) then
        Section:Paragraph({ Title = "Unavailable", Desc = "Appliance remotes/config not found." })
    else
        local order = {}
        for key, data in pairs(ApplianceConfig.Items) do
            order[#order + 1] = { key = key, data = data }
        end
        table.sort(order, function(a, b)
            return (a.data.Order or 99) < (b.data.Order or 99)
        end)

        local labelToKey, labels = {}, {}
        for _, e in ipairs(order) do
            local label = string.format("%s (P%s)", tostring(e.data.DisplayName or e.key), formatNumber(e.data.Cost or 0))
            labels[#labels + 1] = label
            labelToKey[label] = e.key
        end

        local selectedKey = order[1] and order[1].key
        local autoUpgrade = false
        local busy = false

        local function fetch()
            local ok, data = pcall(function() return GetApplianceData:InvokeServer() end)
            if ok and type(data) == "table" then return data.ApplianceUpgrades or {} end
            return nil
        end

        local function startUpgrade(key)
            if busy then return false, "busy" end
            busy = true
            local ok, success, msg = pcall(function() return BuyAppliance:InvokeServer(key) end)
            busy = false
            if ok and success then return true end
            return false, (ok and msg) or "failed"
        end

        Section:Dropdown({
            Title = "Appliance",
            Desc = "Pick what to upgrade (previous tier must be unlocked)",
            Values = labels,
            Value = labels[1],
            Callback = function(v)
                local label = type(v) == "table" and (v.Value or v[1]) or tostring(v)
                selectedKey = labelToKey[label] or selectedKey
            end
        })

        Section:Button({
            Title = "Start Upgrade",
            Desc = "Starts the upgrade timer for the selected appliance",
            Icon = "solar:cart-large-bold",
            Callback = function()
                task.spawn(function()
