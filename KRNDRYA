    UI:Toggle({
        Title = "Hide Orbs",
        Desc = "Hides the orbs in the window, notifications and popups [Slightly improve performance]",
        Icon = "lucide:eye-off",
        Flag = "HideOrbs",
        Value = false,

        Callback = function(V)
            Window:SetOrbsHidden(V)
        end,
    })

    UI:Toggle({
        Title = "Transparent Mode",
        Desc = "Enables the glass appearance for the window, cards and notifications.",
        Icon = "solar:layers-bold",
        Flag = "TransparentMode",
        Value = StartTransparent,

        Callback = function(V)
            Window:SetTransparent(V)
        end,
    })

    UI:Slider({
        Title = "Background Opacity",
