    end

    disconnectDrinkConns()

    table.insert(drinkConns, SoftdrinkOrdersUpdated.OnClientEvent:Connect(function(orders)
        if type(orders) == "table" then
            activeDrinkOrders = {}

            for _, drink in pairs(orders) do
                table.insert(activeDrinkOrders, resolveDrinkKey(drink))
            end
        end
    end))

    table.insert(drinkConns, AdditionalOrder.OnClientEvent:Connect(function(_npcName, drinkKey)
        if drinkKey ~= nil then
            table.insert(activeDrinkOrders, resolveDrinkKey(drinkKey))
        end
    end))

    local drinkStats = {
        given = 0,
        state = "Watching for requests"
    }

    table.insert(drinkConns, NPCDrink.OnClientEvent:Connect(function(_npcName, drinkKey)
        drinkStats.given += 1
        drinkStats.state = string.format("Delivered %s!", resolveDrinkKey(drinkKey))
    end))

    local function buyIngredientBase(key)
        local ingCfg = IngredientsConfig[key]

        if not ingCfg or not ingCfg.Cost or getCash() - ingCfg.Cost < 5000 then
            return false
        end

        local ok, result = pcall(function()
            return BuyIngredient:InvokeServer(key, 1, "Cash")
        end)

        return ok and result
    end

    stepFulfillSoftdrinkOrders = function()
        if not cfg.autoSoftdrinks then return false end
        if #activeDrinkOrders == 0 then return false end

        local drinkKey = resolveDrinkKey(activeDrinkOrders[1])
        local now = os.clock()

        if now < (lastDrinkAttempt[drinkKey] or 0) then return false end
        lastDrinkAttempt[drinkKey] = now + 1.5

        local ingredients = LocalPlayer:FindFirstChild("Ingredients")
        local stock = ingredients and ingredients:FindFirstChild(drinkKey)

        if not stock or stock.Value <= 0 then
            if cfg.autoBuyIngredients then
                buyIngredientBase(drinkKey)
                task.wait(0.2)

                ingredients = LocalPlayer:FindFirstChild("Ingredients")
                stock = ingredients and ingredients:FindFirstChild(drinkKey)
            end

            if not stock or stock.Value <= 0 then
                lastDrinkAttempt[drinkKey] = now + 5
                drinkStats.state = drinkKey .. " out of stock"
                return false
            end
        end

        local ok, success, msg = pcall(function()
            return GiveSoftdrink:InvokeServer(drinkKey)
        end)

        if ok and success then
            table.remove(activeDrinkOrders, 1)
            drinkStats.given += 1
            drinkStats.state = string.format("Delivered %s!", drinkKey)
            return true
        end

        if tostring(msg):match("Nobody") or tostring(msg):match("ordered") then
            table.remove(activeDrinkOrders, 1)
        end

        drinkStats.state = string.format("%s: %s", drinkKey, tostring(msg or success))
        return false
    end

    local myAssignedNPCs = {}

    trackNPC = function(npcId)
        if npcId and npcId ~= "" then
            myAssignedNPCs[npcId] = true
        end
    end

    isMyRunaway = function(npc)
        return npc
            and myAssignedNPCs[npc.Name] == true
    end

end

local detectedBoxKey, detectedBox
local CHOPPY_PRICE = 10000
local getChoppyQuantity, buyChoppyBox, getMysteryPrompt, openChoppyBox

do
    if MysteryBoxConfig then
        for boxKey, boxData in pairs(MysteryBoxConfig) do
            if type(boxData) == "table" then
                detectedBoxKey = tostring(boxKey)
                detectedBox = {
                    Key = tostring(boxKey),
                    DisplayName = tostring(boxData.DisplayName or boxKey),
                    MaxQuantity = tonumber(boxData.MaxQuantity) or 5,
                    ETASeconds = tonumber(boxData.ETASeconds) or 300
                }
                break
            end
        end
    end

    local choppyBoxBusy, choppyOpenBusy = false, false

    getChoppyQuantity = function()
        return math.clamp(math.floor(tonumber(cfg.choppyBoxQuantity) or 1), 1, detectedBox and detectedBox.MaxQuantity or 5)
    end

    buyChoppyBox = function(quantity)
        if not detectedBoxKey or choppyBoxBusy then return false end
        quantity = math.clamp(math.floor(tonumber(quantity) or 1), 1, detectedBox and detectedBox.MaxQuantity or 5)
        choppyBoxBusy = true
        local ok, result = pcall(function()
            return BuyMysteryBox:InvokeServer(detectedBoxKey, quantity)
        end)
        choppyBoxBusy = false
        if ok and result ~= false then
            pcall(function()
                Toolkit:Notify({
                    Title = "Choppy Box",
                    Content = string.format("Bought %d Choppy Box%s for ₱%s", quantity, quantity == 1 and "" or "es", formatNumber(CHOPPY_PRICE * quantity)),
                    Duration = 2.5
                })
            end)
            return true
        end
        return false
    end

    getMysteryPrompt = function()
        local plot = getPlot()
        if not plot then return nil end
        for _, obj in ipairs(plot:GetDescendants()) do
            if obj.Name == "Mystery" and obj:IsA("Model") then
                local place = obj:FindFirstChild("MysteryPlace")
                local prompt = place and place:IsA("BasePart") and place:FindFirstChild("Proximity")
                if prompt and prompt:IsA("ProximityPrompt") then
                    return prompt
                end
            end
        end
        return nil
    end

    openChoppyBox = function()
        if choppyOpenBusy then return false end
        local prompt = getMysteryPrompt()
        if not prompt or not prompt.Enabled then return false end
        choppyOpenBusy = true
        local ok = pcall(function()
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = 9999
            prompt.HoldDuration = 0
            if typeof(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.05)
                prompt:InputHoldEnd()
            end
        end)
        task.delay(1, function()
            choppyOpenBusy = false
        end)
        return ok
    end
end

