            setAntiAFK(v)
        end
    })

    setAntiAFK(true, true)

    local Stats = game:GetService("Stats")

    local StatsConfig = {
        Enabled = false,
        Icon = "solar:cpu-bolt-bold",
        Interval = 0.5,

        Colors = {
            Good = "#00FF88",
            Okay = "#FFD700",
            Bad = "#FF3366",
        },

        Thresholds = {
            FpsBad = 30,
            FpsOkay = 50,
            PingBad = 250,
            PingOkay = 120,
        },
    }

    local function ToColor3(Value, Fallback)
        if typeof(Value) == "Color3" then
            return Value
        end

        if type(Value) == "string" then
            local Ok, Result = pcall(Color3.fromHex, Value)
            if Ok and Result then
                return Result
            end
        end

        return Fallback or Color3.new(1, 1, 1)
    end

    local StatsTag
    local StatsOn = false
    local StatsRun = 0
    local Frames, LastTick, LastLevel = 0, os.clock(), nil
    local FrameConn

    local function GetPing()
        local Ok, Value = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)

        return Ok and math.floor(Value + 0.5) or 0
    end

    local function GetLevel(Fps, Ping)
        local T = StatsConfig.Thresholds

        if Fps < T.FpsBad or Ping > T.PingBad then
            return "Bad"
        elseif Fps < T.FpsOkay or Ping > T.PingOkay then
            return "Okay"
        end

        return "Good"
    end

    local function ApplyStatsColor(Level)
        if not StatsTag then
            return
        end

        LastLevel = Level

        pcall(function()
            StatsTag:SetColor(
                ToColor3(StatsConfig.Colors[Level], Color3.new(1, 1, 1))
            )
        end)
    end

    local function StopStats()
        StatsOn = false
        StatsRun += 1

        if FrameConn then
            FrameConn:Disconnect()
            FrameConn = nil
        end

        if StatsTag then
            pcall(function()
                StatsTag:Destroy()
            end)

            StatsTag = nil
        end

        LastLevel = nil
    end

    local function StartStats()
        if StatsOn then
            return
        end

        StatsOn = true
        StatsRun += 1

        local Run = StatsRun

        Frames, LastTick, LastLevel = 0, os.clock(), nil

        StatsTag = Window:Tag({
            Title = "-- FPS | --ms",
            Icon = StatsConfig.Icon,
            Color = ToColor3(StatsConfig.Colors.Good, Color3.new(1, 1, 1)),
            MinWidth = 96,
        })

        FrameConn = RunService.RenderStepped:Connect(function()
            Frames += 1
        end)

        task.spawn(function()
            while StatsOn and Run == StatsRun do
                task.wait(StatsConfig.Interval)

                if not (StatsOn and Run == StatsRun) then
                    break
                end

                local Now = os.clock()
                local Fps = math.floor(
                    Frames / math.max(Now - LastTick, 0.001) + 0.5
                )

                Frames, LastTick = 0, Now

                local Ping = GetPing()
                local Level = GetLevel(Fps, Ping)

                pcall(function()
                    StatsTag:SetTitle(Fps .. " FPS | " .. Ping .. "ms")
                end)

                if Level ~= LastLevel then
                    ApplyStatsColor(Level)
                end
            end
        end)
    end

    if StatsConfig.Enabled then
        StartStats()
    end

    local StatsSec = SettingsTab:Section({
        Title = "Performance",
    })

    StatsSec:Toggle({
        Title = "Show FPS / Ping",
        Desc = "Displays live FPS and network ping in the window tags.",
        Icon = "solar:cpu-bolt-bold",
        Flag = "ShowStats",
        Value = StatsConfig.Enabled,

        Callback = function(V)
            StatsConfig.Enabled = V

            if V then
                StartStats()
            else
                StopStats()
            end
        end,
    })

