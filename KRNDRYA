    Title = "FIXED Garden Stock and Spike Lag Issues",
    Desc = "Fixed and optimized the Garden auto-buy system due to lag spikes issue that occur during purchases."
})

do
    local plantStock = { Pots = {}, Seeds = {} }

    local categories = {
        Pots = {
            name = "Pots",
            cfgKey = "plantPots",
            toggleKey = "autoBuyPots",
            names = {},
            entries = {},
            byDisplay = {},
            byClean = {},
            signature = "",
            dropdown = nil,
        },
        Seeds = {
            name = "Seeds",
            cfgKey = "plantSeeds",
            toggleKey = "autoBuySeeds",
            names = {},
            entries = {},
            byDisplay = {},
            byClean = {},
            signature = "",
            dropdown = nil,
        },
    }

    local categoryList = { categories.Pots, categories.Seeds }

    local busy = {
        Pots = false,
        Seeds = false,
        Stock = false,
    }

    local suppressUntil = 0
    local uiPending = false

    local function isMerchantActive()
        return Workspace:GetAttribute("GlobalHalamanEvent") == true
    end

    local function getCleanGardenName(label)
        return tostring(label):gsub("%s*%[Stock:%s*%d+%]%s*$", "")
    end

    local function fetchGardenStock()
        if not GetHalamanStock then
            return false
        end

        local ok, result = pcall(function()
            return GetHalamanStock:InvokeServer()
        end)

        if not ok or type(result) ~= "table" then
            return false
        end

        local newPots, newSeeds = {}, {}

        if type(result.Pots) == "table" then
            for k, v in pairs(result.Pots) do
                newPots[tostring(k)] = tonumber(v) or 0
            end
        end

        if type(result.Seeds) == "table" then
            for k, v in pairs(result.Seeds) do
                newSeeds[tostring(k)] = tonumber(v) or 0
            end
        end

        plantStock.Pots = newPots
        plantStock.Seeds = newSeeds

        return true
    end

    local function buildCategoryList(cat)
        local source = PlantConfig and PlantConfig[cat.name]
        local entries = {}

        if type(source) == "table" then
            for key, data in pairs(source) do
                local keyStr = tostring(key)
                local name = type(data) == "table"
                    and (data.Name or data.DisplayName)
                    or keyStr

                name = tostring(name)

                table.insert(entries, {
                    key = keyStr,
                    name = name,
                    display = string.format(
                        "%s [Stock: %d]",
                        name,
                        plantStock[cat.name][keyStr] or 0
                    ),
                })
            end
        end

        table.sort(entries, function(a, b)
            if a.name == b.name then
                return a.key < b.key
            end

            return a.name < b.name
        end)

        local names = {}

        for _, entry in ipairs(entries) do
            names[#names + 1] = entry.display
        end

        local signature = table.concat(names, "\1")

        if signature == cat.signature then
            return false
        end

        cat.signature = signature
        cat.entries = entries
        cat.names = names
        cat.byDisplay = {}
        cat.byClean = {}

        for _, entry in ipairs(entries) do
            cat.byDisplay[entry.display] = entry.key
            cat.byClean[entry.name] = entry.key
        end

        return true
    end

    local function applyDropdown(cat)
        local dd = cat.dropdown
        if not dd then
            return
        end

        local sel = cfg[cat.cfgKey]
        local snapshot = {}

        for k, v in pairs(sel) do
            if v then
                snapshot[k] = true
            end
        end

        local restored = {}

        for _, entry in ipairs(cat.entries) do
            if snapshot[entry.key] or snapshot[entry.name] then
                restored[#restored + 1] = entry.display
            end
        end

        suppressUntil = os.clock() + 0.6

        pcall(function()
            if dd.SetValues then
                dd:SetValues(cat.names)
            elseif dd.Refresh then
                dd:Refresh(cat.names)
            end
        end)

        task.defer(function()
            pcall(function()
                if dd.SetValue then
                    dd:SetValue(restored)
                elseif dd.Select then
                    dd:Select(restored)
                end
            end)

            table.clear(sel)

            for k in pairs(snapshot) do
                sel[k] = true
            end
        end)
    end

    local function refreshDropdowns()
        for _, cat in ipairs(categoryList) do
            if buildCategoryList(cat) then
                applyDropdown(cat)
            end
        end
    end

    local function purchaseCategory(cat)
        local category = cat.name

        if busy[category] then
            return false, category .. " purchase is already running."
        end

        if not BuyHalamanItem then
            return false, "Purchase remote unavailable."
        end

        if not isMerchantActive() then
            return false, "Garden Merchant is not active."
        end

        local selected = cfg[cat.cfgKey]

        if type(selected) ~= "table" or next(selected) == nil then
            return false, "Please select " .. category .. " first."
        end

        busy[category] = true

        local callOK, boughtAny = pcall(function()
            if not fetchGardenStock() then
                return false
            end

            local stockTbl = plantStock[category]
            local bought = false

            for key, enabled in pairs(selected) do
                if enabled and isMerchantActive() then
                    local remaining = stockTbl[key] or 0

                    while remaining > 0 and isMerchantActive() do
                        local ok, result = pcall(function()
                            return BuyHalamanItem:InvokeServer(
                                category,
                                key
                            )
                        end)

                        if not ok or result == false then
                            break
                        end

                        remaining -= 1
                        stockTbl[key] = remaining
                        bought = true

                        task.wait(0.1)
                    end
                end
            end

            return bought
        end)

        busy[category] = false

        if not callOK then
            return false, "Purchase failed due to an error."
        end

        if boughtAny then
            return true, "Finished buying selected " .. category .. "."
        end

        return false, "No items purchased. Check available stock."
    end

    local function hasAnySelection()
        if cfg.autoBuyPots
            and next(cfg.plantPots) ~= nil then
            return true
        end

        if cfg.autoBuySeeds
            and next(cfg.plantSeeds) ~= nil then
            return true
        end

        return false
    end

    local function runAutoCategory(cat)
        if not cfg[cat.toggleKey] then
            return
        end

        if busy[cat.name] then
            return
        end

        task.spawn(function()
            purchaseCategory(cat)
        end)
    end

    local function runCycle()
        if not isMerchantActive() then
            return
        end

        if not busy.Stock then
            busy.Stock = true

            local ok = fetchGardenStock()

            busy.Stock = false

            if ok and uiPending then
                uiPending = false

                for _, cat in ipairs(categoryList) do
                    if buildCategoryList(cat) then
                        applyDropdown(cat)
                    end
                end
            end
        end

        runAutoCategory(categories.Pots)
        runAutoCategory(categories.Seeds)
