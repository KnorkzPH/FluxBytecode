do
    local R = Remotes:FindFirstChild("WorkerRemotes")
    local RollWorker = R and R:FindFirstChild("RollWorker")
    local HireWorker = R and R:FindFirstChild("HireWorker")
    local GetWaitingWorkers = R and R:FindFirstChild("GetWaitingWorkers")
    local WorkerAppeared = R and R:FindFirstChild("WorkerAppeared")

    local RollSection = WorkersTab:Section({ Title = "Roll" })

    if not (RollWorker and HireWorker and GetWaitingWorkers) then
        RollSection:Paragraph({ Title = "Unavailable", Desc = "Worker remotes not found." })
    else
        local okCfg, WorkerConfig = pcall(function()
            return require(Modules:WaitForChild("WorkerConfig", 5))
        end)

        if not (okCfg and type(WorkerConfig) == "table") then
            WorkerConfig = {}
        end

        local roleOrder = type(WorkerConfig.RoleOrder) == "table"
            and WorkerConfig.RoleOrder
            or { "Assigner", "Dishwasher", "Server1F", "Server" }
        local maxHired = tonumber(WorkerConfig.MaxHiredWorkers) or 3

        local rarityValues, seen = {}, {}

        for _, rarity in ipairs({ "Common", "Steamer", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Avengers" }) do
            seen[rarity] = true
            rarityValues[#rarityValues + 1] = rarity
        end

        if type(WorkerConfig.Workers) == "table" then
            for _, data in pairs(WorkerConfig.Workers) do
                local rarity = type(data) == "table" and data.Rarity
                if rarity and not seen[rarity] then
                    seen[rarity] = true
                    rarityValues[#rarityValues + 1] = rarity
                end
            end
        end

        local candidates = {}
        local hiredRoles = {}
        local failedNames = {}
        local selectedRarity = {}
        local autoRoll = false
        local autoHire = false
        local rollDelay = 5
        local cashReserve = 0
        local rolling = false
        local hiring = false
        local nextCost = nil

        local rolledView = RollSection:Paragraph({ Title = "Rolled Workers", Desc = "No roll yet" })
        local costView = RollSection:Paragraph({ Title = "Roll Cost", Desc = "Loading..." })

        local HireSection = WorkersTab:Section({ Title = "Hire" })
        local staffView = HireSection:Paragraph({ Title = "Staff", Desc = "Checking..." })

        local function describe(list)
            if type(list) ~= "table" or #list == 0 then
                return "No workers waiting"
            end

            local lines = {}

            for i, w in ipairs(list) do
                if type(w) == "table" then
                    lines[#lines + 1] = string.format(
                        "%d. %s [%s] Wage %s | Speed %s | Sleep %s%% | %s day(s)",
                        i,
                        tostring(w.Template or w.Name),
                        tostring(w.Rarity or "?"),
                        tostring(w.Wage or "?"),
                        tostring(w.Speed or "?"),
                        tostring(w.SleepChance or "?"),
                        tostring(w.Days or "?")
                    )
                end
            end

            return table.concat(lines, "\n")
        end

        local function hiredCount()
            local n = 0
            for _ in pairs(hiredRoles) do n += 1 end
            return n
        end

        local function staffFull()
            if hiredCount() >= maxHired then return true end

            for _, role in ipairs(roleOrder) do
                if not hiredRoles[role] then return false end
            end

            return true
        end

        local function updateViews()
            pcall(function()
                rolledView:SetDesc(describe(candidates))
            end)

            pcall(function()
                local roles = {}
                for role in pairs(hiredRoles) do roles[#roles + 1] = tostring(role) end
                table.sort(roles)

                staffView:SetDesc(string.format(
                    "Hired %d/%d%s",
                    hiredCount(),
                    maxHired,
                    #roles > 0 and (" (" .. table.concat(roles, ", ") .. ")") or ""
                ))
            end)
        end

        local function refreshWaiting()
            local ok, _, list, hired = pcall(function()
                return GetWaitingWorkers:InvokeServer()
            end)

            if ok and type(list) == "table" then
                candidates = list
                hiredRoles = type(hired) == "table" and hired or {}
                updateViews()
                return true
            end

            return false
        end

        local function showCost()
            pcall(function()
                costView:SetDesc(nextCost and ("P" .. formatNumber(nextCost)) or "Unknown")
            end)
        end

        local function readCost()
            local ok, success, _, cost = pcall(function()
                return RollWorker:InvokeServer("GetCost")
            end)

            if ok and success then
                nextCost = tonumber(cost) or nextCost
                showCost()
                return tonumber(cost)
            end

            return nil
        end

        local function hireCandidate(worker)
            for _, role in ipairs(roleOrder) do
                if not hiredRoles[role] then
                    local ok, success = pcall(function()
                        return HireWorker:InvokeServer(worker.Name, role)
                    end)

                    if ok and success then
                        hiredRoles[role] = true
                        return true, role
                    end
                end
            end

            return false
        end

        local function hirePass()
            if hiring then return 0 end
            hiring = true

            local count = 0

            pcall(function()
                if next(selectedRarity) == nil then return end

                for _, worker in ipairs(candidates) do
                    if type(worker) == "table"
                        and worker.Name
                        and selectedRarity[tostring(worker.Rarity)]
                        and not failedNames[worker.Name]
                        and not staffFull() then

                        local ok, role = hireCandidate(worker)

                        if ok then
                            count += 1

                            Toolkit:Notify({
                                Title = "Workers",
                                Content = string.format("Hired %s [%s] as %s", tostring(worker.Template or worker.Name), tostring(worker.Rarity), tostring(role)),
                                Duration = 3
                            })
                        else
                            failedNames[worker.Name] = true
                        end

                        task.wait(0.3)
                    end
                end
            end)

            hiring = false

            if count > 0 then
                refreshWaiting()
            end

            return count
        end

        local function rollOnce()
            if rolling then return false, "busy" end
            rolling = true

            local ok, success, msg, newCost = pcall(function()
                return RollWorker:InvokeServer("Roll")
            end)

            rolling = false

            if ok and success then
                nextCost = tonumber(newCost) or nextCost
                showCost()
                task.wait(0.6)
                table.clear(failedNames)
                refreshWaiting()
                return true, msg
            end

            return false, (ok and msg) or "Roll failed."
        end

        RollSection:Button({
            Title = "Roll Worker (once)",
            Desc = "Spends Cash on a worker roll. The price goes up after every roll",
            Icon = "solar:cart-large-bold",
            Callback = function()
                task.spawn(function()
                    local ok, reason = rollOnce()

                    Toolkit:Notify({
                        Title = "Workers",
                        Content = ok and tostring(reason or "Rolled!") or tostring(reason),
                        Duration = 3
                    })
                end)
            end
        })

        RollSection:Toggle({
            Title = "Auto Roll Workers",
            Desc = "Keeps rolling while Cash stays above the reserve. Stops when your staff is full",
            Value = false,
            Callback = function(v)
                autoRoll = v
            end
        })

        RollSection:Slider({
            Title = "Roll Delay",
            Desc = "Seconds between rolls",
            Value = { Min = 1, Max = 60, Default = rollDelay },
            Step = 1,
            Callback = function(v)
                rollDelay = tonumber(v) or 5
            end
        })

        RollSection:Slider({
            Title = "Cash Reserve",
            Desc = "Auto Roll stops when Cash after the roll would drop below this",
            Value = { Min = 0, Max = 1000000, Default = cashReserve },
            Step = 5000,
            Callback = function(v)
                cashReserve = tonumber(v) or 0
            end
        })

        HireSection:Dropdown({
            Title = "Hire Rarities",
            Desc = "Auto Hire only hires rolled workers with these rarities",
            Values = rarityValues,
            Value = {},
            Multi = true,
            AllowNone = true,
            Callback = function(option)
                table.clear(selectedRarity)

                if type(option) == "table" then
                    for _, rarity in ipairs(option) do
                        selectedRarity[tostring(rarity)] = true
                    end
                end
            end
        })

        HireSection:Toggle({
            Title = "Auto Hire Rolled Workers",
            Desc = "Hires matching workers into the first free role",
            Value = false,
            Callback = function(v)
                autoHire = v

                if v then
                    task.spawn(function()
                        if refreshWaiting() then hirePass() end
                    end)
                end
            end
        })

        HireSection:Button({
            Title = "Hire Matching Now",
            Desc = "Hire the waiting workers that match the selected rarities",
            Icon = "solar:user-plus-bold",
            Callback = function()
                task.spawn(function()
                    refreshWaiting()
                    local count = hirePass()

                    Toolkit:Notify({
                        Title = "Workers",
                        Content = count > 0 and ("Hired " .. count .. " worker(s).") or "No matching worker was hired.",
                        Duration = 3
                    })
                end)
            end
        })

        if WorkerAppeared then
            WorkerAppeared.OnClientEvent:Connect(function(plot, list)
                if plot ~= getPlot() or type(list) ~= "table" then return end

                candidates = list
                table.clear(failedNames)
                updateViews()

                if autoHire then
                    task.spawn(function()
                        refreshWaiting()
                        hirePass()
                    end)
                end
            end)
        end

        task.spawn(function()
            local fails = 0

            while true do
                if autoRoll or autoHire then
                    if refreshWaiting() and autoHire then
                        hirePass()
                    end

                    if autoRoll then
                        if staffFull() then
                            task.wait(5)
                        else
                            local cost = readCost()

                            if cost and getCash() - cost >= cashReserve then
                                local ok = rollOnce()

                                if ok then
                                    fails = 0
                                    if autoHire then hirePass() end
                                else
                                    fails += 1
                                end

                                task.wait(math.max(rollDelay, fails > 0 and math.min(2 ^ fails, 30) or 0))
                            else
                                task.wait(3)
                            end
                        end
                    else
                        task.wait(3)
                    end
                else
                    task.wait(1.5)
                end
            end
        end)

        task.spawn(refreshWaiting)

        task.spawn(function()
            while true do
                if not rolling then readCost() end
                task.wait(5)
            end
        end)
    end
end

do
    local R = Remotes:FindFirstChild("WorkerRemotes")
    local WakeWorkerEvent = R and R:FindFirstChild("WakeWorkerEvent")
    local WakeSection = WorkersTab:Section({ Title = "Wake" })

    if not WakeWorkerEvent then
        WakeSection:Paragraph({ Title = "Unavailable", Desc = "Wake remote not found." })
    else
        cfg.autoWakeWorkers = false

        local lastWake = setmetatable({}, { __mode = "k" })

        WakeSection:Paragraph({
            Title = "Weapon",
            Desc = "Uses the pan selected in Main > Pan To Use. Your character swings it next to each sleeping worker, then returns to where you were."
        })

        local function isMine(model)
            local plot = getPlot()

            if plot and model:IsDescendantOf(plot) then return true end

            local plotName = model:GetAttribute("NPCPlotName")
            if plotName == nil then return false end

            if plotName == LocalPlayer:GetAttribute("WorkPlot") then return true end

            return plot ~= nil and plot.Name == plotName
        end

        local function wakeOne(model)
            local stop = function()
                return not cfg.autoWakeWorkers or Sched.blocked("autoWakeWorkers")
            end

            runJob("Wake", function()
                if stop() then return end
                if not (model.Parent and model:GetAttribute("IsSleeping") == true) then return end

                local char, hum, root = getChar()
                if not (char and hum and root) or hum.Health <= 0 then return end

                local target = model:FindFirstChild("HumanoidRootPart")
                    or model.PrimaryPart
                    or model:FindFirstChildWhichIsA("BasePart", true)
                if not target then return end

                local origin = root.CFrame
                local pan = findPanTool()

                if pan and pan.Parent ~= char then
                    pcall(function() hum:EquipTool(pan) end)
                    if not waitUnless(0.15, stop) then return end
                end

                root.CFrame = CFrame.lookAt(target.Position + Vector3.new(0, 0, 3), target.Position)
                root.AssemblyLinearVelocity = Vector3.zero

                if not waitUnless(0.2, stop) then
                    root.CFrame = origin
                    return
                end

                if pan and pan.Parent == char then
                    pcall(function() pan:Activate() end)
                end

                pcall(function()
                    WakeWorkerEvent:FireServer(model.Name)
                end)

                waitUnless(0.25, stop)

                pcall(function() hum:UnequipTools() end)

                if root.Parent then
                    root.CFrame = origin
                    root.AssemblyLinearVelocity = Vector3.zero
                end
            end)
        end

        local function wakeTick()
            local candidates = {}
            local plot = getPlot()

            local npcs = Workspace:FindFirstChild("ClientNPCs")
            if npcs then
                for _, child in ipairs(npcs:GetChildren()) do
                    candidates[#candidates + 1] = child
                end
            end

            local spawnFolder = Workspace:FindFirstChild("WorkerSpawn")
            if spawnFolder then
                for _, child in ipairs(spawnFolder:GetDescendants()) do
                    if child:IsA("Model") then candidates[#candidates + 1] = child end
                end
            end

            if plot then
                for _, child in ipairs(plot:GetDescendants()) do
                    if child:IsA("Model") then candidates[#candidates + 1] = child end
                end
            end

            for _, model in ipairs(candidates) do
                if not cfg.autoWakeWorkers then break end

                if model:GetAttribute("IsWorker") == true
                    and model:GetAttribute("IsSleeping") == true
                    and os.clock() - (lastWake[model] or 0) > 4
                    and isMine(model) then

                    lastWake[model] = os.clock()
                    wakeOne(model)
                end
            end
        end

        WakeSection:Toggle({
            Title = "Auto Wake Workers",
            Desc = "Wakes your sleeping workers with the selected pan",
            Value = false,
            Callback = function(v)
                cfg.autoWakeWorkers = v
            end
        })

        task.spawn(function()
            while true do
                if cfg.autoWakeWorkers then
                    pcall(wakeTick)
                    task.wait(1.5)
                else
                    task.wait(1)
                end
            end
        end)
    end
end
