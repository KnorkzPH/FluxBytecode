            while true do
                if autoUpgrade then
                    local upgrades = fetch()
                    if upgrades then
                        local anyRunning = false
                        for _, st in pairs(upgrades) do
                            if st.IsUpgrading then anyRunning = true end
                        end

                        if not anyRunning then
                            for _, e in ipairs(order) do
                                local st = upgrades[e.key]
                                local req = e.data.Requirement
                                local reqOk = (not req) or (upgrades[req] and upgrades[req].Unlocked)
                                if st and not st.Unlocked and reqOk and getCash() >= (e.data.Cost or math.huge) then
                                    startUpgrade(e.key)
                                    break
                                end
                            end
                        end
                    end
                    task.wait(30)
                else
                    task.wait(2)
                end
            end
        end)
