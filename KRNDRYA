local Actions = {}

do
    local function unblockPrompt(prompt)
        if prompt and prompt:IsA("ProximityPrompt") then
            pcall(function()
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 20)
                prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
            end)
        end
    end

    Actions.unblockPrompt = unblockPrompt

    local _lastTPAt = 0
    local _teleportHomeEvent = nil

    local function _getHomeEvent()
        if not _teleportHomeEvent then
            _teleportHomeEvent = pcall(function()
                _teleportHomeEvent = ReplicatedStorage:WaitForChild("Remotes", 5)
                    and ReplicatedStorage.Remotes:FindFirstChild("TeleportHomeEvent")
            end)
            _teleportHomeEvent = ReplicatedStorage:FindFirstChild("Remotes")
                and ReplicatedStorage.Remotes:FindFirstChild("TeleportHomeEvent")
        end
        return _teleportHomeEvent
    end

    local function _getPingSeconds()
        local ok, v = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        return ok and (v / 1000) or 0.08
    end

    function Actions.mover(mode)
        if mode == "fly" then
            return function(pos, stop)
                return flyTweenWaypoints(pos, stop)
            end
        end

        return function(pos)
            local _, _, root = getChar()
            if not root then return false end

            local gap = math.max(0, 0.18 - (os.clock() - _lastTPAt))
            if gap > 0 then task.wait(gap) end

            if cfg.antiSyncToggle then
                pcall(function()
                    local ev = _getHomeEvent()
                    if ev then ev:FireServer() end
                end)
                local pingFloor = _getPingSeconds() + 0.05
                task.wait(math.max(0.06, pingFloor))
            end

            local jx = (math.random() - 0.5) * 1.4
            local jz = (math.random() - 0.5) * 1.4
            local jittered = pos + Vector3.new(jx, 0, jz)

            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
            root.CFrame = CFrame.new(jittered) * root.CFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            _lastTPAt = os.clock()
            return true
        end
    end

    function Actions.startLoop(label, flag, action, mode, interval)
        task.spawn(function()
            while true do
                if cfg[flag] then
                    if Sched.blocked(flag) then
                        task.wait(0.1)
                    else
                        local ok, err = pcall(action, mode, flag)

                        if not ok then
                            warn("[" .. label .. "] " .. tostring(err))
                            task.wait(1)
                        end

                        task.wait(type(interval) == "function" and interval() or interval)
                    end
                else
                    task.wait(0.3)
                end
            end
        end)
    end

    local PC = {
        t = -10,
        plot = nil,
        food = {},
        customers = {},
        dirty = {},
        sinkPut = {},
        sinkWash = {},
    }

    local function has(text, word)
        return string.find(text, word, 1, true) ~= nil
    end

    local function isDirtyText(a, o)
        return has(o, "dirty") or has(o, "dish") or has(a, "wash") or has(a, "pick")
    end

    local function isCustomerServeText(a, o)
        return has(a, "serve") or has(a, "give") or has(o, "serve")
    end

    local function isFoodPrompt(d, serve)
        local pos = getPromptCFrame(d)
        if pos and pos.Position.Y < 4 then return false end

        local cur = d.Parent
        while cur and cur ~= serve do
            if cur.Name == "13" then return false end
            cur = cur.Parent
        end

        local topModel = d:FindFirstAncestorOfClass("Model")
        if topModel and topModel.Name:sub(1, 7) == "Cooked_" then
            return true
        end

        return d.Parent ~= nil and d.Parent:IsA("BasePart")
    end

    local function slotOf(d, root)
        local cur = d
        while cur and cur.Parent ~= root do
            cur = cur.Parent
        end
        return cur
    end

    function Actions.getPromptCache(plot, force)
        local now = os.clock()

        if not force and PC.plot == plot and now - PC.t < 0.35 then
            return PC
        end

        local food, customers, dirty, sinkPut, sinkWash = {}, {}, {}, {}, {}

        local serve = plot:FindFirstChild("Serve")
        local dp = plot:FindFirstChild("DiningPlot1")
        local sink = plot:FindFirstChild("Sink")

        if serve then
            for _, d in ipairs(serve:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then
                    local a, o = lowerText(d.ActionText), lowerText(d.ObjectText)

                    if isDirtyText(a, o) then
                        dirty[#dirty + 1] = d
                    end

                    if isFoodPrompt(d, serve) then
                        food[#food + 1] = d
                    end
                end
            end
        end

        if dp then
            for _, d in ipairs(dp:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then
                    local a, o = lowerText(d.ActionText), lowerText(d.ObjectText)

                    if isDirtyText(a, o) then
                        dirty[#dirty + 1] = d
                    end

                    if isCustomerServeText(a, o) then
                        local slot = slotOf(d, dp)

                        if slot and slot:IsA("Model") then
                            customers[#customers + 1] = { slot = slot, prompt = d }
                        end
                    end
                end
            end
        end

        if sink then
            for _, d in ipairs(sink:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled then
                    local a, o = lowerText(d.ActionText), lowerText(d.ObjectText)

                    if has(a, "put") or has(a, "place") or d.Name == "Put" then
                        sinkPut[#sinkPut + 1] = d
                    elseif has(a, "wash") or has(a, "clean") or has(a, "scrub")
                        or has(o, "dish") or has(o, "dirty") or has(o, "plate") then
                        sinkWash[#sinkWash + 1] = d
                    end
                end
            end
        end

        PC.plot, PC.t = plot, os.clock()
        PC.food, PC.customers, PC.dirty = food, customers, dirty
        PC.sinkPut, PC.sinkWash = sinkPut, sinkWash

        return PC
    end

    local function findCustomerPromptInModel(model)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled
                and isCustomerServeText(lowerText(d.ActionText), lowerText(d.ObjectText)) then
                return d
            end
        end

        return nil
    end

    local function waitForPromptInModel(model, timeout, stop)
        local started = os.clock()

        repeat
            local found = findCustomerPromptInModel(model)
            if found then return found end
            task.wait(0.03)
        until os.clock() - started >= timeout or (stop and stop())

        return nil
    end

    function Actions.serve(mode, flag)
        local stop = function()
            return not cfg[flag] or Sched.blocked(flag)
        end

        local plot = getPlot()
        if not plot then return end

        local move = Actions.mover(mode)
        local d

        if mode == "fly" then
            d = { foodTp = 0.08, foodTrigger = 0.03, custTp = 0.10, custTrigger = 0.03, custPost = 0.15 }
        else
            local m = serveModes[cfg.serveMode] or serveModes["Hybrid"]
            local pingFloor = _getPingSeconds() + 0.05
            d = {
                foodTp = math.max(m.foodTp, pingFloor),
                foodTrigger = m.foodTrigger,
                custTp = math.max(m.customerTp, pingFloor),
                custTrigger = m.customerTrigger,
                custPost = m.customerDelay
            }
        end

        local pc = Actions.getPromptCache(plot)
        local served = 0

        local function serveOne(desc, tpWait, trigWait, targetModel)
            local done = false

            runJob("Serve", function()
                if stop() then return end
                if not (desc.Parent and desc.Enabled) then return end

                local cf = getPromptCFrame(desc)
                if not cf then return end

                if not move(cf.Position + Vector3.new(0, 3, 0), stop) then return end
                if not waitUnless(tpWait, stop) then return end

                local toFire = desc

                if targetModel then
                    toFire = waitForPromptInModel(targetModel, 0.3, stop)
                end

                if toFire and toFire.Parent and toFire.Enabled and forceFirePrompt(toFire, trigWait) then
                    waitUnless(trigWait > 0 and trigWait or 0.02, stop)
                    served += 1
                    done = true
                end
            end)

            return done
        end

        for _, desc in ipairs(pc.food) do
            if served >= 8 or stop() then break end

            if desc.Parent and desc.Enabled then
                serveOne(desc, d.foodTp, d.foodTrigger, nil)
            end
        end

        for _, entry in ipairs(pc.customers) do
            if served >= 8 or stop() then break end

            if entry.prompt.Parent and entry.prompt.Enabled then
                if serveOne(entry.prompt, d.custTp, d.custTrigger, entry.slot) and d.custPost > 0 then
                    waitUnless(d.custPost, stop)
                end
            end
        end

    end

    local function heldDishTool()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")

        if tool and not Sched.isPanTool(tool) then
            return tool
        end

        return nil
    end

    local function stowHeldTool()
        local tool = heldDishTool()

        if tool then
            pcall(function()
                tool.Parent = LocalPlayer.Backpack
            end)
        end
    end

    local function firstUsable(list)
        for _, p in ipairs(list) do
            if p.Parent and p.Enabled and p.Parent:IsA("BasePart") then
                return p
            end
        end

        return nil
    end

    local function placeAtSink(move, stop)
        local plot = getPlot()
        if not plot then return end

        local fresh = Actions.getPromptCache(plot, true)
        local putPrompt = firstUsable(fresh.sinkPut)

        if putPrompt then
            unblockPrompt(putPrompt)

            if move(putPrompt.Parent.Position + Vector3.new(0, 3, 0), stop)
                and waitUnless(0.15, stop)
                and putPrompt.Parent
                and putPrompt.Enabled then

                forceFirePrompt(putPrompt, 0.02)
                waitUnless(0.2, stop)
            end
        end

        if not stop() then
            stowHeldTool()
            Sched.carriedDish = nil
        end
    end

    local function pickAndPlace(prompt, move, stop)
        local part = prompt.Parent
        if not (part and part:IsA("BasePart")) then return end

        unblockPrompt(prompt)

        if not move(part.Position + Vector3.new(0, 3, 0), stop) then return end
        if not waitUnless(0.12, stop) then return end
        if not (prompt.Parent and prompt.Enabled) then return end

        forceFirePrompt(prompt, 0.02)

        local started = os.clock()
        while not heldDishTool() and os.clock() - started < 1.5 do
            if stop() then return end
            task.wait(0.05)
        end

        if not heldDishTool() then return end
        Sched.carriedDish = heldDishTool()
        if not waitUnless(0.1, stop) then return end

        placeAtSink(move, stop)
    end

    local function resumeCarriedDish(move, stop)
        local dish = Sched.carriedDish
        if not dish then return end

        local char, hum = getChar()
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if not (dish.Parent and (dish.Parent == char or dish.Parent == backpack)) then
            Sched.carriedDish = nil
            return
        end

        if dish.Parent ~= char and hum then
            pcall(function() hum:EquipTool(dish) end)

            local started = os.clock()
            while dish.Parent ~= char and os.clock() - started < 0.5 do
                if stop() then return end
                task.wait(0.05)
            end
        end

        if dish.Parent == char then
            placeAtSink(move, stop)
        else
            Sched.carriedDish = nil
        end
    end

    local function washAtSink(prompt, move, stop)
        local part = prompt.Parent
        if not (part and part:IsA("BasePart")) then return end

        local target = part.Position + Vector3.new(0, 3, 0)

        unblockPrompt(prompt)

        if not move(target, stop) then return end
        if not waitUnless(0.25, stop) then return end

        local holding = false
        local started = os.clock()

        while prompt.Parent and prompt.Enabled and not stop() and os.clock() - started < 3 do
            local _, _, root = getChar()
            if not root then break end

            if (root.Position - part.Position).Magnitude > 8 then
                if holding then
                    pcall(function() prompt:InputHoldEnd() end)
                    holding = false
                end

                if not move(target, stop) then break end
                waitUnless(0.2, stop)
            end

            if not holding then
                holding = pcall(function()
                    prompt:InputHoldBegin()
                end)
            end

            task.wait(0.1)
        end

        if holding then
            pcall(function() prompt:InputHoldEnd() end)
        end
    end

    function Actions.wash(mode, flag)
        local stop = function()
            return not cfg[flag] or Sched.blocked(flag)
        end

        local plot = getPlot()
        if not plot then return end

        local move = Actions.mover(mode)
        local pc = Actions.getPromptCache(plot)

        runJob("Wash", function()
            resumeCarriedDish(move, stop)
        end)

        for _, prompt in ipairs(pc.dirty) do
            if stop() then return end

            if prompt.Parent and prompt.Enabled then
                runJob("Wash", function()
                    pickAndPlace(prompt, move, stop)
                end)

                task.wait(0.1)
            end
        end

        for _ = 1, 8 do
            if stop() then return end

            local fresh = Actions.getPromptCache(plot, true)
            local washPrompt = firstUsable(fresh.sinkWash)
            if not washPrompt then break end

            runJob("Wash", function()
                washAtSink(washPrompt, move, stop)
            end)

            task.wait(0.1)
        end

        if not stop() then
            Sched.washFirstUntil = 0
        end
    end

    do
        local CollectionService = game:GetService("CollectionService")

        local TAG = "GarbagePrompt"
        local HOLD_TIME = 0.5
        local SAFETY_LIMIT = 45
        local SAFETY_COOLDOWN = 10
        local CARRY_TIMEOUT = 60
        local RUN_INTERVAL = 0.8
        local IDLE_RECHECK = 5

        local THROW_ATTEMPTS = 8
        local THROW_CONFIRM_WAIT = 0.8
        local PUTBACK_COOLDOWN = 3

        local alive = true
        local entries = {}
        local nextSeq = 0
        local conns = {}
        local truck, truckConn
        local dirty = false
        local wake = Instance.new("BindableEvent")

        local STOP_CONFIRM = 0.8
        local STOP_MOVE_EPS = 0.2
        local SAMPLE_INTERVAL = 0.2
        local SETTLE_FALLBACK = 45
        local WAIT_STOP_MAX = 40

        local motion = { pos = nil, lastMove = os.clock(), since = os.clock() }
        local lastSettled, lastConfigOk = false, true

        local garbageConfigPresent = false
        local GarbageConfig = nil

        local CFGALLOW = { "enabled", "enable", "activate", "active", "running", "autospawn", "spawnenabled" }
        local CFGDENY = { "disabled", "disable", "paused", "pause" }

        local garbageConfigAllows
        do
            local checkedAt, allowed = -math.huge, false

            local function readConfig()
                local mod = Modules:FindFirstChild("GarbageConfig")
                if not mod then
                    garbageConfigPresent = false
                    return false
                end

                local ok, conf = pcall(require, mod)
                if not ok or type(conf) ~= "table" then
                    garbageConfigPresent = false
                    return false
                end

                garbageConfigPresent = true
                GarbageConfig = conf

                for name, value in pairs(conf) do
                    if type(value) == "boolean" then
                        local n = string.lower(tostring(name))

                        for _, word in ipairs(CFGDENY) do
                            if string.find(n, word, 1, true) and value then
                                return false
                            end
                        end

                        for _, word in ipairs(CFGALLOW) do
                            if string.find(n, word, 1, true) and not value then
                                return false
                            end
                        end
                    end
                end

                return true
            end

            garbageConfigAllows = function()
                local now = os.clock()

                if now - checkedAt >= 1 then
                    checkedAt = now
                    allowed = readConfig()
                end

                return allowed
            end
        end

        local carrying = false
        local carryTime = 0

        local handStateOk, HandState = pcall(function()
            return require(Modules:WaitForChild("HandState", 10))
        end)
        handStateOk = handStateOk
            and type(HandState) == "table"
            and type(HandState.IsHoldingGarbage) == "function"
        local holdStart = nil

        local state = {
            work = false,
            lastNeed = 0,
            needSince = nil,
            cooldownUntil = 0,
            holdFor = nil,
        }

        local genv = (typeof(getgenv) == "function" and getgenv()) or _G
        if type(genv.__KarinderyaGarbageCleanup) == "function" then
            pcall(genv.__KarinderyaGarbageCleanup)
        end

        local function plotOf(prompt)
            local parent = prompt.Parent
            while parent and parent.Parent ~= Workspace do
                parent = parent.Parent
            end
            return parent
        end

        local function kindOf(prompt)
            local action = prompt:GetAttribute("GarbageAction")
            if action == nil and prompt.Name == "PickUpPrompt" then
                return "PickUp"
            end
            return action
        end

        local recompute

        local function markDirty()
            if not alive or dirty then return end
            dirty = true

            task.defer(function()
                if alive then recompute() end
            end)
        end

        local function truckOk()
            return truck ~= nil
                and truck.Parent ~= nil
                and truck:GetAttribute("Leaving") ~= true
        end

        local POSITIVE_ATTRS = { "stopped", "parked", "arrived", "atstop" }
        local NEGATIVE_ATTRS = { "moving", "driving", "arriving", "approaching", "enroute" }

        local function nameHas(name, list)
            for _, key in ipairs(list) do
                if string.find(name, key, 1, true) then return true end
            end
            return false
        end

        local function attrVerdict(t)
            local verdict = nil

            for name, value in pairs(t:GetAttributes()) do
                if type(value) == "boolean" then
                    local n = string.lower(name)

                    if n ~= "leaving" then
                        if nameHas(n, POSITIVE_ATTRS) then
                            if value then verdict = true else return false end
                        elseif nameHas(n, NEGATIVE_ATTRS) then
                            if value then return false else verdict = true end
                        end
                    end
                end
            end

            return verdict
        end

        local function truckPosition(t)
            if not t then return nil end

            local primary = t:FindFirstChild("Primary")
            if primary and primary:IsA("BasePart") then
                return primary.Position
            end

            local ok, pivot = pcall(function() return t:GetPivot().Position end)
            return ok and pivot or nil
        end

        local function sampleTruck()
            local pos = truckPosition(truck)
            if not pos then return end

            if not motion.pos or (pos - motion.pos).Magnitude > STOP_MOVE_EPS then
                motion.pos = pos
                motion.lastMove = os.clock()
            end
        end

        local function truckSettled()
            if not truckOk() then return false end

            local now = os.clock()
            local verdict = attrVerdict(truck)

            if verdict == false then return false end

            local stillFor = now - motion.lastMove

            if verdict == true then
                return stillFor >= 0.3
            end

            if stillFor >= STOP_CONFIRM then return true end

            return now - motion.since >= SETTLE_FALLBACK
        end

        local function isHolding()
            if handStateOk then
                local ok, res = pcall(HandState.IsHoldingGarbage)
                if ok then return res == true end
            end

            return carrying and os.clock() - carryTime <= CARRY_TIMEOUT
        end

        local function carryActive()
            if isHolding() then
                if not holdStart then
                    holdStart = os.clock()
                    task.delay(CARRY_TIMEOUT + 0.05, markDirty)
                end

                return os.clock() - holdStart <= CARRY_TIMEOUT
            end

            holdStart = nil
            return false
        end

        local function hasWork()
            if not garbageConfigAllows() then return false end

            local plot = getPlot()
            if not plot then return false end

            if carryActive() then return true end

            if not truckSettled() then return false end

            for prompt, entry in pairs(entries) do
                if entry.kind == "PickUp"
                    and prompt.Enabled
                    and prompt.Parent
                    and prompt.Parent:IsA("BasePart")
                    and plotOf(prompt) == plot then
                    return true
                end
            end

            return false
        end

        recompute = function()
            dirty = false

            local enabled = cfg.autoGarbage or cfg.main2AutoGarbage
            local now = os.clock()
            local work = enabled and hasWork() or false

            local carryBusy = enabled and carryActive()
            local need = work and (carryBusy or now >= state.cooldownUntil)

            state.work = work

            if need then
                state.lastNeed = now
                state.holdFor = nil
                Sched.garbage = true

                if not state.needSince then
                    local since = now
                    state.needSince = since

                    task.delay(SAFETY_LIMIT, function()
                        if alive and state.needSince == since and carryActive() then
                            state.needSince = nil
                            markDirty()
                        elseif alive and state.needSince == since then
                            state.cooldownUntil = os.clock() + SAFETY_COOLDOWN
                            state.needSince = nil
                            state.lastNeed = 0
                            task.delay(SAFETY_COOLDOWN + 0.05, markDirty)
                            markDirty()
                        end
                    end)
                end

                wake:Fire()
                return
            end

            state.needSince = nil

            if enabled and now - state.lastNeed < HOLD_TIME then
                Sched.garbage = true

                if state.holdFor ~= state.lastNeed then
                    state.holdFor = state.lastNeed
                    task.delay(state.lastNeed + HOLD_TIME - now + 0.02, markDirty)
                end
            else
                Sched.garbage = false
            end

            if work then
                wake:Fire()
            end
        end

        local function setCarrying(value)
            carrying = value

            if value then
                carryTime = os.clock()
                task.delay(CARRY_TIMEOUT + 0.05, markDirty)
            end

            markDirty()
        end

        local function waitHolding(timeout)
            local started = os.clock()

            repeat
                if isHolding() then return true end
                task.wait(0.05)
            until os.clock() - started >= timeout

            return false
        end

        local function waitNotHolding(timeout)
            local started = os.clock()

            repeat
                if not isHolding() then return true end
                task.wait(0.05)
            until os.clock() - started >= timeout

            return false
        end

        local function throwConfirmed(firedAny)
            if handStateOk then
                return waitNotHolding(THROW_CONFIRM_WAIT)
            end

            return firedAny
        end

        local function untrack(prompt)
            local entry = entries[prompt]
            if not entry then return end

            entries[prompt] = nil

            for _, c in ipairs(entry.conns) do
                c:Disconnect()
            end

            markDirty()
        end

        local function track(prompt)
            if entries[prompt] or not prompt:IsA("ProximityPrompt") then return end

            nextSeq += 1

            local entry = { kind = kindOf(prompt), seq = nextSeq, conns = {} }
            entries[prompt] = entry

            entry.conns[1] = prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
                if entry.kind == "PickUp" then
                    markDirty()
                end
            end)

            entry.conns[2] = prompt:GetAttributeChangedSignal("GarbageAction"):Connect(function()
                entry.kind = kindOf(prompt)
                markDirty()
            end)

            markDirty()
        end

        local function sortedPrompts(filter)
            local list = {}

            for prompt, entry in pairs(entries) do
                if prompt.Parent and filter(prompt, entry) then
                    list[#list + 1] = prompt
                end
            end

            table.sort(list, function(a, b)
                return entries[a].seq < entries[b].seq
            end)

            return list
        end

        local function pickupPrompts(plot)
            return sortedPrompts(function(prompt, entry)
                return entry.kind == "PickUp"
                    and prompt.Enabled
                    and prompt.Parent:IsA("BasePart")
                    and plotOf(prompt) == plot
            end)
        end

        local function throwPrompts(primary)
            local list = sortedPrompts(function(prompt, entry)
                return entry.kind == "Throw" and prompt.Parent == primary
            end)

            if #list == 0 then
                for _, prompt in ipairs(primary:GetChildren()) do
                    if prompt:IsA("ProximityPrompt") then
                        list[#list + 1] = prompt
                    end
                end
            end

            return list
        end

        local function putBackBag(plot, move, stop)
            for _ = 1, 2 do
                if stop() then return false end
                if not isHolding() then return true end

                local list = sortedPrompts(function(prompt, entry)
                    return entry.kind == "PutBack" and plotOf(prompt) == plot
                end)

                local fired = false

                for _, prompt in ipairs(list) do
                    local cf = getPromptCFrame(prompt)

                    if cf then
                        unblockPrompt(prompt)

                        if not move(cf.Position + Vector3.new(0, 3, 0), stop) then return false end
                        if not waitUnless(0.25, stop) then return false end

                        if forceFirePrompt(prompt, 0.02) then
                            fired = true
                            break
                        end
                    end
                end

                if fired then
                    if handStateOk then
                        if waitNotHolding(THROW_CONFIRM_WAIT) then return true end
                    else
                        return true
                    end
                end

                waitUnless(0.2, stop)
            end

            return not isHolding()
        end

        local function bindTruck(newTruck)
            if truck == newTruck then return end

            if truckConn then
                truckConn:Disconnect()
                truckConn = nil
            end

            truck = newTruck

            motion.pos = nil
            motion.lastMove = os.clock()
            motion.since = os.clock()
            lastSettled = false

            if truck then
                truckConn = truck:GetAttributeChangedSignal("Leaving"):Connect(markDirty)
            end

            markDirty()
        end

        conns[#conns + 1] = CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
        conns[#conns + 1] = CollectionService:GetInstanceRemovedSignal(TAG):Connect(untrack)

        conns[#conns + 1] = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "GarbageTruck" then
                bindTruck(child)
            end
        end)

        conns[#conns + 1] = Workspace.ChildRemoved:Connect(function(child)
            if child == truck then
                bindTruck(Workspace:FindFirstChild("GarbageTruck"))
            end
        end)

        for _, instance in ipairs(CollectionService:GetTagged(TAG)) do
            track(instance)
        end

        bindTruck(Workspace:FindFirstChild("GarbageTruck"))

        task.spawn(function()
            while alive do
                sampleTruck()

                if cfg.autoGarbage or cfg.main2AutoGarbage then
                    local settled = truckSettled()
                    local configOk = garbageConfigAllows()

                    if settled ~= lastSettled or configOk ~= lastConfigOk then
                        lastSettled = settled
                        lastConfigOk = configOk
                        markDirty()
                    end

                    task.wait(SAMPLE_INTERVAL)
                else
                    task.wait(0.5)
                end
            end
        end)

        local function dumpTable(t, indent, depth, out)
            if depth > 3 then
                out[#out + 1] = indent .. "..."
                return
            end

            local keys = {}
            for k in pairs(t) do keys[#keys + 1] = k end
            table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)

            for _, k in ipairs(keys) do
                local v = t[k]

                if type(v) == "table" then
                    out[#out + 1] = indent .. tostring(k) .. ":"
                    dumpTable(v, indent .. "  ", depth + 1, out)
                else
                    out[#out + 1] = indent .. tostring(k) .. " = " .. tostring(v)
                end
            end
        end

        function Sched.dumpGarbageConfig()
            local out = { "=== GarbageConfig ===" }

            if GarbageConfig then
                dumpTable(GarbageConfig, "  ", 0, out)
            else
                out[#out + 1] = "  (Modules.GarbageConfig not found / failed to require)"
            end

            out[#out + 1] = "=== GarbageTruck ==="
            local t = truck or Workspace:FindFirstChild("GarbageTruck")

            if t then
                out[#out + 1] = "  path: " .. t:GetFullName()
                for name, value in pairs(t:GetAttributes()) do
                    out[#out + 1] = "  attr " .. tostring(name) .. " = " .. tostring(value)
                end
                out[#out + 1] = "  settled(by script) = " .. tostring(truckSettled())
                out[#out + 1] = "  still for (s) = " .. string.format("%.2f", os.clock() - motion.lastMove)
            else
                out[#out + 1] = "  (no GarbageTruck in Workspace right now)"
            end

            out[#out + 1] = "=== Auto Garbage (truck) checks ==="
            out[#out + 1] = "  GarbageConfig present = " .. tostring(garbageConfigPresent)
            out[#out + 1] = "  GarbageConfig allows garbage = " .. tostring(garbageConfigAllows())
            out[#out + 1] = "  holding garbage bag = " .. tostring(isHolding())
            out[#out + 1] = "  truck settled (fully stopped) = " .. tostring(truckSettled())

            local pickCount = 0
            for prompt, entry in pairs(entries) do
                if entry.kind == "PickUp" and prompt.Enabled and prompt.Parent then
                    pickCount += 1
                end
            end
            out[#out + 1] = "  garbage bags spawned on plot = " .. pickCount

            out[#out + 1] = "=== Time (Auto Clean Trash schedule) ==="
            out[#out + 1] = "  Lighting.ClockTime = " .. tostring(game:GetService("Lighting").ClockTime)
            out[#out + 1] = "  isNight(by script) = " .. tostring(isNightNow())
            out[#out + 1] = "  Auto Clean Trash mode = " .. tostring(cfg.cleanTrashTime)

            out[#out + 1] = "=== Auto Clean Trash (GlobalTrashSpawner) ==="
            local spawner = Workspace:FindFirstChild("GlobalTrashSpawner")
            out[#out + 1] = "  GlobalTrashSpawner = " .. (spawner and spawner:GetFullName() or "(not found)")

            if spawner then
                local trashCount = 0

                for _, object in ipairs(spawner:GetDescendants()) do
                    if object:IsA("ProximityPrompt")
                        and object.Enabled
                        and object:GetAttribute("IsTrash") == true then
                        trashCount += 1
                    end
                end

                out[#out + 1] = "  enabled trash prompts = " .. trashCount
            end

            out[#out + 1] = "  Auto Clean Trash running = " .. tostring(cfg.autoCleanTrash)

            local text = table.concat(out, "\n")

            if typeof(setclipboard) == "function" then
                pcall(setclipboard, text)
            end

            pcall(function()
                Toolkit:Notify({
                    Title = "Garbage Debug",
                    Content = "Dumped to console (and clipboard if supported).",
                    Duration = 4
                })
            end)
        end

        conns[#conns + 1] = LocalPlayer.CharacterAdded:Connect(function()
            carrying = false
            markDirty()
        end)

        if handStateOk and HandState.Changed then
            pcall(function()
                conns[#conns + 1] = HandState.Changed:Connect(markDirty)
            end)
        end

        function Sched.pokeGarbage()
            markDirty()
            wake:Fire()
        end

        local function cleanup()
            alive = false
            Sched.garbage = false

            for _, c in ipairs(conns) do c:Disconnect() end
            for prompt in pairs(entries) do untrack(prompt) end
            if truckConn then truckConn:Disconnect() end

            wake:Fire()
        end

        genv.__KarinderyaGarbageCleanup = cleanup

        function Actions.garbage(mode, flag)
            local stop = function()
                return not cfg[flag] or Sched.blocked(flag)
            end

            local plot = getPlot()
            if not plot then return end

            local currentTruck = truck or Workspace:FindFirstChild("GarbageTruck")
            if currentTruck and currentTruck ~= truck then
                bindTruck(currentTruck)
            end

            local truckPresent = currentTruck ~= nil
                and currentTruck.Parent ~= nil
                and currentTruck:GetAttribute("Leaving") ~= true

            local truckReady = truckPresent and truckSettled()

            local move = Actions.mover(mode)

            local function resolveHeld()
                if not isHolding() then return true end

                local verified = false

                if not truckOk() or not truckSettled() or not garbageConfigAllows() then
                    local started = os.clock()

                    while not stop()
                        and truckOk()
                        and not truckSettled()
                        and isHolding()
                        and os.clock() - started < WAIT_STOP_MAX do
                        task.wait(0.1)
                    end

                    truckReady = truckOk() and truckSettled() and garbageConfigAllows()
                end

                if truckReady and garbageConfigAllows() then
                    runJob("Garbage", function()
                        for _ = 1, THROW_ATTEMPTS do
                            if stop() then return end

                            if not (currentTruck.Parent and currentTruck:GetAttribute("Leaving") ~= true) then
                                return
                            end

                            if not truckSettled() or not garbageConfigAllows() then
                                break
                            end

                            local primary = currentTruck:FindFirstChild("Primary")
                            if not (primary and primary:IsA("BasePart")) then return end

                            if not move(primary.Position + Vector3.new(0, 3, 2), stop) then return end
                            if not waitUnless(0.3, stop) then return end

                            local firedAny = false

                            for _, prompt in ipairs(throwPrompts(primary)) do
                                if stop() then return end

                                if prompt.Parent then
                                    unblockPrompt(prompt)

                                    if forceFirePrompt(prompt, 0.02) then
                                        firedAny = true
                                    end

                                    waitUnless(0.25, stop)
                                end
                            end

                            if stop() then return end

                            if throwConfirmed(firedAny) then
                                verified = true
                                return
                            end

                            waitUnless(0.2, stop)
                        end
                    end)
                end

                if verified or not isHolding() then
                    setCarrying(false)
                    return true
                end

                if stop() then return false end

                runJob("Garbage", function()
                    putBackBag(plot, move, stop)
                end)

                if not isHolding() then
                    setCarrying(false)
                    state.cooldownUntil = os.clock() + PUTBACK_COOLDOWN
                    markDirty()
                    task.delay(PUTBACK_COOLDOWN + 0.05, markDirty)
                end

                return false
            end

            if not resolveHeld() then return end
            if stop() then return end

            if not truckReady then return end

            if not garbageConfigAllows() then return end

            for _, prompt in ipairs(pickupPrompts(plot)) do
                if stop() then return end
                if isHolding() then break end

                local mesh = prompt.Parent

                if mesh and mesh:IsA("BasePart") and prompt.Enabled then
                    local picked = false

                    runJob("Garbage", function()
                        if stop() then return end

                        unblockPrompt(prompt)

                        if not move(mesh.Position + Vector3.new(0, 3, 0), stop) then return end
                        if not waitUnless(0.2, stop) then return end

                        if prompt.Parent and prompt.Enabled and forceFirePrompt(prompt, 0.02) then
                            if handStateOk then
                                picked = waitHolding(0.8)
                            else
                                setCarrying(true)
                                picked = true
                            end
                        end

                        waitUnless(0.1, stop)
                    end)

                    if picked and not resolveHeld() then
                        return
                    end

                    task.wait(0.05)
                end
            end
        end

        local function idleWait()
            local timer = task.delay(IDLE_RECHECK, function()
                wake:Fire()
            end)

            wake.Event:Wait()
            pcall(task.cancel, timer)
        end

        function Actions.startGarbageLoop(label, flag, mode)
            task.spawn(function()
                while alive do
                    if not cfg[flag] or not state.work then
                        idleWait()
                    elseif Sched.blocked(flag) then
                        task.wait(0.1)
                    elseif os.clock() < state.cooldownUntil and not isHolding() then
                        task.wait(0.25)
                    else
                        local ok, err = pcall(Actions.garbage, mode, flag)

                        if not ok then
                            warn("[" .. label .. "] " .. tostring(err))
                            task.wait(1)
                        end

                        task.wait(RUN_INTERVAL)
                    end
                end
            end)
        end
    end
end

