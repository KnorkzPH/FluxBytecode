do
    local TRASH_SPAWNER = "GlobalTrashSpawner"

    local MAX_FAILS = 3
    local FAIL_COOLDOWN = 6

    local PropEquipEvent = Remotes:FindFirstChild("PropEquipEvent")
    local trashCamOriginal = LocalPlayer.DevCameraOcclusionMode

    local cleanState = setmetatable({}, { __mode = "k" })

    local function setBroomEquipped(equipped)
        if not PropEquipEvent then
            PropEquipEvent = Remotes:FindFirstChild("PropEquipEvent")
        end

        if PropEquipEvent then
            pcall(function()
                PropEquipEvent:FireServer("Broom", equipped)
            end)
        end
    end

    local function restoreCam()
        pcall(function()
            LocalPlayer.DevCameraOcclusionMode = trashCamOriginal
        end)
    end

    local function trashTimeAllowed()
        local mode = cfg.cleanTrashTime
        if mode == "Day" then return not isNightNow() end
        if mode == "Night" then return isNightNow() end
        return true
    end

    local function registerFail(trash)
        local st = cleanState[trash] or { fails = 0, until_ = 0 }
        st.fails += 1
        st.until_ = os.clock() + FAIL_COOLDOWN
        cleanState[trash] = st
    end

    local function resolveTrash(prompt)
        local parent = prompt.Parent
        if not parent then return nil, nil end

        local model = prompt:FindFirstAncestorOfClass("Model")
        if model then
            local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
            if part then return model, part end
            return model, parent:IsA("BasePart") and parent or nil
        end

        if parent:IsA("BasePart") then
            return parent, parent
        end

        return nil, nil
    end

    local trashPrompts = setmetatable({}, { __mode = "k" })
    local trashConns = {}
    local boundSpawner = nil
    local fallbackScanAt = 0

    local function bindSpawner(spawner)
        for _, conn in ipairs(trashConns) do
            conn:Disconnect()
        end

        table.clear(trashConns)
        table.clear(trashPrompts)
        boundSpawner = spawner

        if not spawner then return end

        for _, object in ipairs(spawner:GetDescendants()) do
            if object:IsA("ProximityPrompt") then
                trashPrompts[object] = true
            end
        end

        trashConns[1] = spawner.DescendantAdded:Connect(function(object)
            if object:IsA("ProximityPrompt") then
                trashPrompts[object] = true
            end
        end)

        trashConns[2] = spawner.DescendantRemoving:Connect(function(object)
            trashPrompts[object] = nil
        end)
    end

    local function refreshTrashPrompts()
        local spawner = Workspace:FindFirstChild(TRASH_SPAWNER)

        if spawner ~= boundSpawner then
            bindSpawner(spawner)
            fallbackScanAt = 0
        end

        if spawner then return end

        local now = os.clock()
        if now < fallbackScanAt then return end
        fallbackScanAt = now + 10

        table.clear(trashPrompts)

        for _, object in ipairs(Workspace:GetDescendants()) do
            if object:IsA("ProximityPrompt") and object:GetAttribute("IsTrash") == true then
                trashPrompts[object] = true
            end
        end
    end

    local function findNearestTrash()
        local _, _, hrp = getChar()
        if not hrp then return nil, nil, nil end

        refreshTrashPrompts()

        local now = os.clock()

        local bestPrompt, bestTrash, bestPart
        local bestDistance = math.huge

        for object in pairs(trashPrompts) do
            if object.Parent
                and object.Enabled
                and object:GetAttribute("IsTrash") == true then

                local trash, part = resolveTrash(object)

                if trash and part and trash.Parent then
                    local st = cleanState[trash]
                    local cooled = st and now < st.until_
                    local failedOut = st and st.fails >= MAX_FAILS

                    if not cooled and not failedOut then
                        local distance = (hrp.Position - part.Position).Magnitude

                        if distance < bestDistance then
                            bestDistance = distance
                            bestPrompt = object
                            bestTrash = trash
                            bestPart = part
                        end
                    end
                end
            end
        end

        return bestPrompt, bestTrash, bestPart
    end

    cleanTrashReset = function()
        setBroomEquipped(false)
        restoreCam()
        Sched.cleanTrash = false
    end

    local function cleanOne(prompt, trash, part)
        local stop = function()
            return not cfg.autoCleanTrash
                or Sched.blocked("autoCleanTrash")
                or Sched.garbage == true
                or not trashTimeAllowed()
        end

        local function promptAlive()
            return prompt
                and prompt.Parent
                and prompt:IsDescendantOf(game)
                and prompt.Enabled
        end

        local function trashAlive()
            return trash
                and trash.Parent
                and part
                and part.Parent
        end

        if stop() then return false end

        if not promptAlive() or not trashAlive() then
            return not promptAlive()
        end

        local _, _, root = getChar()
        if not root then return false end

        root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        if not waitUnless(0.14, stop) then return false end
        if not promptAlive() or not trashAlive() then
            return not promptAlive()
        end

        setBroomEquipped(true)

        pcall(function()
            LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
        end)

        if not waitUnless(0.80, stop) then
            setBroomEquipped(false)
            restoreCam()
            return false
        end

        if stop() or not (prompt and prompt.Parent and prompt:IsDescendantOf(game)) then
            setBroomEquipped(false)
            restoreCam()
            return false
        end

        pcall(function()
            prompt:InputHoldBegin()

            local holdDuration = tonumber(prompt.HoldDuration) or 2.8
            local started = os.clock()

            while not stop()
                and prompt
                and prompt.Parent
                and prompt:IsDescendantOf(game)
                and os.clock() - started < holdDuration do
                task.wait(0.15)
            end

            if prompt and prompt.Parent then
                pcall(function()
                    prompt:InputHoldEnd()
                end)
            end
        end)

        pcall(function()
            if prompt and prompt.Parent then
                prompt:InputHoldEnd()
            end
        end)

        setBroomEquipped(false)
        restoreCam()

        if not cfg.autoCleanTrash then return false end

        task.wait(0.35)

        if not trash.Parent
            or not prompt.Parent
            or not prompt:IsDescendantOf(game) then
            return true
        end

        registerFail(trash)
        return false
    end

    task.spawn(function()
        while true do
            if not cfg.autoCleanTrash then
                Sched.cleanTrash = false
                task.wait(0.3)
            elseif Sched.blocked("autoCleanTrash") or not trashTimeAllowed() then
                Sched.cleanTrash = false
                task.wait(0.25)
            else
                local prompt, trash, part = findNearestTrash()

                if not prompt then
                    Sched.cleanTrash = false
                    task.wait(1)
                else
                    Sched.cleanTrash = false

                    runJob("CleanTrash", function()
                        Sched.cleanTrash = true

                        local ok, err = pcall(cleanOne, prompt, trash, part)

                        Sched.cleanTrash = false

                        if not ok then
                            warn("[CleanTrash] " .. tostring(err))
                            registerFail(trash)
                        end
                    end)

                    task.wait(0.3)
                end
            end
        end
    end)
end

