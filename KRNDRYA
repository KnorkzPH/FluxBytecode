do
    local PisoRemotes = Remotes:FindFirstChild("PisoRemotes")
    local GetPisoStock = PisoRemotes and PisoRemotes:FindFirstChild("GetPisoStock")
    local BuyPisoItem = PisoRemotes and PisoRemotes:FindFirstChild("BuyPisoItem")
    local PisoRestocked = PisoRemotes and PisoRemotes:FindFirstChild("PisoRestocked")

    local PisoSection = EventTab:Section({ Title = "Piso Event" })

    if not (GetPisoStock and BuyPisoItem) then
        PisoSection:Paragraph({
            Title = "Unavailable",
            Desc = "Piso remotes were not found. The game may have changed."
        })
    else
        local selected = {}
        local autoBuy = false
        local busy = false
        local fails = {}

        local function pisoActive()
            return Workspace:GetAttribute("GlobalPisoEvent") == true
        end

        local function fetchStock()
            local ok, result = pcall(function()
                return GetPisoStock:InvokeServer()
            end)

            if ok and type(result) == "table" then
                return result
            end

            return nil
        end

        local function buyPass()
            if busy then return 0, "busy" end
            busy = true

            local bought = 0
            local reason = nil

            local ok, err = pcall(function()
                local data = fetchStock()

                if not data then
                    reason = "stock request failed"
                    return
                end

                if not data.IsActive then
                    reason = "event shop is not active"
                    return
                end

                local anySelected = next(selected) ~= nil

                for _, item in pairs(data.Items or {}) do
                    if type(item) == "table" and item.Category and item.Key then
                        local wanted = (not anySelected) or selected[tostring(item.Category)]
                        local id = tostring(item.Category) .. ":" .. tostring(item.Key)

                        if wanted and (fails[id] or 0) < 3 then
                            local ok2, success = pcall(function()
                                return BuyPisoItem:InvokeServer(item.Category, item.Key)
                            end)

                            if ok2 and success then
                                bought += 1
                                fails[id] = nil
                            else
                                fails[id] = (fails[id] or 0) + 1
                            end

                            task.wait(0.15)
                        end
                    end
                end

                if bought == 0 and not reason then
                    reason = "nothing bought (sold out or not enough Piso)"
                end
            end)

            busy = false

            if not ok then
                warn("[Piso] " .. tostring(err))
                reason = "error"
            end

            return bought, reason
        end

        PisoSection:Paragraph({
            Title = "How it works",
            Desc = "Buys items from the Piso event shop. If no category is selected, every category is bought."
        })

        local categories = { "Chairs", "Tables", "Stoves", "Paints", "Materials", "Tiles" }

        PisoSection:Dropdown({
            Title = "Categories",
            Desc = "Leave empty to buy everything",
            Values = categories,
            Value = {},
            Multi = true,
            AllowNone = true,
            Callback = function(option)
                table.clear(selected)

                if type(option) == "table" then
                    for _, name in ipairs(option) do
                        selected[tostring(name)] = true
                    end
                end
            end
        })

        PisoSection:Toggle({
            Title = "Auto Buy Piso Shop",
            Desc = "Checks the event shop and buys automatically while the event is on",
            Value = false,
            Callback = function(value)
                autoBuy = value
            end
        })

        PisoSection:Button({
            Title = "Buy Now",
            Desc = "Run one buy pass right now",
            Icon = "solar:cart-large-bold",
            Callback = function()
                task.spawn(function()
                    local bought, reason = buyPass()

                    Toolkit:Notify({
                        Title = "Piso Event",
                        Content = bought > 0
                            and ("Bought " .. bought .. " item(s).")
                            or (reason or "Nothing bought."),
                        Duration = 3
                    })
                end)
            end
        })

        if PisoRestocked then
            PisoRestocked.OnClientEvent:Connect(function()
                table.clear(fails)

                if autoBuy then
                    task.delay(0.5, function()
                        buyPass()
                    end)
                end
            end)
        end

        task.spawn(function()
            while true do
                if autoBuy and pisoActive() then
                    buyPass()
                    task.wait(5)
                else
                    task.wait(2)
                end
            end
        end)
    end
end

