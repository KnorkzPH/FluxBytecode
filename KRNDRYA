Sched.blocked = function(flag)
    if Sched.pan then
        return true
    end

    if Sched.angpao
        and flag ~= "autoAngpao"
        and flag ~= "autoGarbage"
        and flag ~= "main2AutoGarbage" then
        return true
    end

    if (flag == "autoServe" or flag == "main2AutoServe")
        and os.clock() < Sched.washFirstUntil
        and (cfg.autoWash or cfg.main2AutoWash) then
        return true
    end

    if Sched.garbage and flag ~= "autoGarbage" and flag ~= "main2AutoGarbage" then
        return true
    end

    if Sched.cleanTrash
        and flag ~= "autoCleanTrash"
        and flag ~= "autoGarbage"
        and flag ~= "main2AutoGarbage" then
        return true
    end

    return false
end

