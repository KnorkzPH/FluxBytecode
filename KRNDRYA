local Lighting = game:GetService("Lighting")

local function isNightNow()
    local flag = Lighting:GetAttribute("IsNight")
    if type(flag) == "boolean" then return flag end

    local t = Lighting.ClockTime
    local dayStart = tonumber(cfg.cleanDayStart) or 6
    local nightStart = tonumber(cfg.cleanNightStart) or 18

    if dayStart == nightStart then return false end

    if dayStart < nightStart then
        return t >= nightStart or t < dayStart
    end

    return t >= nightStart and t < dayStart
end

local function formatNumber(amount)
    local formatted = tostring(amount)
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

