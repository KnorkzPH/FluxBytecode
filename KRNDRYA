do
    local isAssigning = false
    local V1_POLL_INTERVAL = 0.89
    local V2_FALLBACK_INTERVAL = 1.5

    local function processNPCAssign()
        if isAssigning or not cfg then return end
        if not (cfg.autoOrder or cfg.autoOrderV2) then return end

        isAssigning = true

        task.spawn(function()
            local success, err = pcall(function()
                if not getPlot or not GetCounterInfo or not AssignNPC then
                    return
                end

                local plot = getPlot()
                if not plot then return end

                local ok, npc, tbls = pcall(function()
                    return GetCounterInfo:InvokeServer()
                end)

                if not ok or type(npc) ~= "table" or type(tbls) ~= "table" then
                    return
                end

                local id = npc.NpcId or npc.TemplateName
                local templateName = npc.TemplateName

                if not id or id == "" or not templateName or templateName == "" then
                    return
                end

                local npcData = NPCConfig
                    and NPCConfig.Types
                    and NPCConfig.Types[templateName]

                local rarity = npcData and npcData.Rarity or "Unknown"

                if cfg.autoRejectNPC
                    and cfg.rejectNPCList
                    and cfg.rejectNPCList[rarity] then

                    if RejectNPC then
                        RejectNPC:FireServer(id, HttpService:GenerateGUID(false))
                    end
                    return
                end

                if typeof(trackNPC) == "function" then
                    pcall(trackNPC, id)
                end

                for _, t in ipairs(tbls) do
                    if t.Slot ~= nil and t.Seat ~= nil then
                        AssignNPC:FireServer({
                            Slot = t.Slot,
                            Seat = t.Seat,
                            NpcId = id
                        }, HttpService:GenerateGUID(false))
                        break
                    end
                end
            end)

            isAssigning = false

            if not success then
                warn("[AutoOrder] " .. tostring(err))
            end
        end)
    end

    if NPCArrivedAtSpot1 and NPCArrivedAtSpot1.OnClientEvent then
        NPCArrivedAtSpot1.OnClientEvent:Connect(function()
            if cfg and (cfg.autoOrder or cfg.autoOrderV2) then
                processNPCAssign()
            end
        end)
    end

    task.spawn(function()
        local nextV2Check = 0

        while true do
            local currentCfg = cfg

            if currentCfg and currentCfg.autoOrder and not currentCfg.autoOrderV2 then
                processNPCAssign()
                task.wait(V1_POLL_INTERVAL)
            elseif currentCfg and currentCfg.autoOrderV2 then
                local now = os.clock()

                if now >= nextV2Check then
                    nextV2Check = now + V2_FALLBACK_INTERVAL
                    processNPCAssign()
                end

                task.wait(0.1)
            else
                task.wait(0.3)
            end
        end
    end)
end

