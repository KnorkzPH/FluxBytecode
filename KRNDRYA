do
    local merchantItemNames = {}
    local merchantItemKeys = {}
    local merchantStock = {}

    local MerchantItemDropdown
    local merchantAutoBusy = false
    local merchantListSig = nil
    local merchantRefreshPending = false
    local merchantWake = false
    local merchantBuyCooldown = {}
    local merchantBuyFails = {}

    local STOCK_CACHE_TTL = 15
    local STOCK_MIN_GAP = 1
    local STOCK_FETCH_TIMEOUT = 10
    local BUY_LOCK_TIMEOUT = 15

    local function makeLock(timeout)
        local lockedAt = nil
        local lock = {}

        function lock.Acquire()
            if lockedAt ~= nil and os.clock() - lockedAt < timeout then
                return false
            end
            lockedAt = os.clock()
            return true
        end

        function lock.Release()
            lockedAt = nil
        end

        return lock
    end

    local function acquireWait(lock, maxWait)
        local deadline = os.clock() + maxWait
        while not lock.Acquire() do
            if os.clock() >= deadline then return false end
            task.wait(0.05)
        end
        return true
    end

    local merchantBuyLock = makeLock(BUY_LOCK_TIMEOUT)

    local function makeStockFetcher(remote, onResult)
        local state = {
            Fetching = false,
            Id = 0,
            Started = 0,
            Attempt = -math.huge,
            FetchedAt = -math.huge,
            Dirty = true,
            Version = 0,
            LastOk = false,
        }

        function state.MarkDirty()
            state.Dirty = true
            state.Version += 1
        end

        function state.Fetch(force)
            if state.Fetching and os.clock() - state.Started < STOCK_FETCH_TIMEOUT then
                local deadline = state.Started + STOCK_FETCH_TIMEOUT
                while state.Fetching and os.clock() < deadline do
                    task.wait()
                end
                return state.LastOk
            end

            if not force then
                local now = os.clock()
                local fresh = (not state.Dirty) and (now - state.FetchedAt < STOCK_CACHE_TTL)
                if fresh or now - state.Attempt < STOCK_MIN_GAP then
                    return state.LastOk
                end
            end

            state.Fetching = true
            state.Started = os.clock()
            state.Attempt = state.Started
            state.Id += 1
            local myId = state.Id
            local version = state.Version

            local ok, result = pcall(function()
                return remote:InvokeServer()
            end)

            if myId ~= state.Id then return state.LastOk end
            state.Fetching = false

            if ok and type(result) == "table" then
                state.LastOk = true
                state.FetchedAt = os.clock()
                if state.Version == version then
                    state.Dirty = false
                end
                pcall(onResult, result)
            else
                state.LastOk = false
            end

            return state.LastOk
        end

        return state
    end

    local function applyMerchantResult(result)
        table.clear(merchantStock)
        for key, item in pairs(result) do
            local itemKey = (type(item) == "table") and (item.Key or item.Id or key) or key
            merchantStock[itemKey] = item
        end
    end

    local merchantFetcher = makeStockFetcher(GetMerchantStock, applyMerchantResult)

    local function autoWait(isActive, shouldWake)
        local waited = 0
        repeat
            task.wait(0.25)
            waited += 0.25
        until not isActive() or waited >= 1.5 or shouldWake(waited)
    end

    local function getMerchantItemName(key)
        local item = MerchantConfig.Items and MerchantConfig.Items[key]
        return (type(item) == "table" and item.Name) and tostring(item.Name) or tostring(key)
    end

    local function getMerchantItemStock(item)
        if type(item) ~= "table" then return tonumber(item) or 0 end
        return tonumber(item.Stock or item.Amount or item.Quantity or 0) or 0
    end

    local function buildMerchantItemList()
        table.clear(merchantItemNames)
        table.clear(merchantItemKeys)

        for _, key in ipairs(MerchantConfig.Order or {}) do
            if MerchantConfig.Items and MerchantConfig.Items[key] then
                local name = getMerchantItemName(key)
                local stock = getMerchantItemStock(merchantStock[key])
                local displayName = string.format("%s [STOCK: %d]", name, stock)

                table.insert(merchantItemNames, displayName)
                merchantItemKeys[displayName] = key
            end
        end
    end

    local function fetchMerchantStock(force)
        return merchantFetcher.Fetch(force)
    end

    local function getCleanMerchantName(label)
        return tostring(label):gsub("%s*%[STOCK:%s*%d+%]%s*$", "")
    end

    local function refreshMerchant()
        local selectedKeys = cfg.merchantItems or {}
        local selectedNames = {}
        for key, selected in pairs(selectedKeys) do
            if selected then selectedNames[key] = true end
        end

        fetchMerchantStock(true)
        buildMerchantItemList()

        if not MerchantItemDropdown then return end

        local sig = table.concat(merchantItemNames, "|")
        if sig == merchantListSig then return end
        merchantListSig = sig

        pcall(function()
            local restored = {}
            for _, displayName in ipairs(merchantItemNames) do
                local cleanName = getCleanMerchantName(displayName)
                for key, _ in pairs(selectedNames) do
                    if merchantItemKeys[displayName] == key or cleanName == key then
                        table.insert(restored, displayName)
                    end
                end
            end

            pcall(function() MerchantItemDropdown:SetValues(merchantItemNames) end)

            task.defer(function()
                pcall(function()
                    if MerchantItemDropdown.SetValue then
                        MerchantItemDropdown:SetValue(restored)
                    end
                end)
            end)
        end)
    end

    local function requestMerchantRefresh(delay)
        if merchantRefreshPending then return end
        merchantRefreshPending = true
        task.delay(delay or 0.3, function()
            merchantRefreshPending = false
            local ok, err = pcall(refreshMerchant)
            if not ok then
                warn("[Merchant] refresh error: " .. tostring(err))
            end
        end)
    end

    local function purchaseMerchantSelected(requireTable)
        local bought = {}

        local keys = {}
        for key, selected in pairs(cfg.merchantItems) do
            if selected then table.insert(keys, key) end
        end

        for _, key in ipairs(keys) do
            local item = merchantStock[key]
            if not requireTable or type(item) == "table" then
                local stock = getMerchantItemStock(item)
                local owned = type(item) == "table" and item.Owned == true
                local now = os.clock()

                if stock > 0 and not owned and now >= (merchantBuyCooldown[key] or 0) then
                    merchantBuyCooldown[key] = now + 1

                    local success, result = pcall(function()
                        return BuyMerchantItem:InvokeServer(key)
                    end)

                    if success and result ~= false then
                        merchantBuyFails[key] = nil
                        table.insert(bought, getMerchantItemName(key))
                        if type(item) == "table" then
                            item.Stock = math.max(0, stock - 1)
                        else
                            merchantStock[key] = math.max(0, stock - 1)
                        end
                        merchantFetcher.MarkDirty()
                    else
                        local fails = (merchantBuyFails[key] or 0) + 1
                        merchantBuyFails[key] = fails
                        merchantBuyCooldown[key] = now + math.min(1.5 * 2 ^ fails, 10)
                    end

                    task.wait(0.05)
                end
            end
        end

        return bought
    end

    local function buyMerchantSelected()
        if not acquireWait(merchantBuyLock, 5) then return end

        local bought = {}
        local ok, err = pcall(function()
            fetchMerchantStock(true)
            bought = purchaseMerchantSelected(false)
        end)
        merchantBuyLock.Release()

        if not ok then
            warn("[Merchant] buy error: " .. tostring(err))
        end

        requestMerchantRefresh(0.2)

        if #bought > 0 then
            pcall(function()
                Toolkit:Notify({ Title = "Merchant", Content = "Bought selected items.", Duration = 1.5 })
            end)
        end
    end

    local function merchantAutoLoop()
        if merchantAutoBusy then return end
        merchantAutoBusy = true

        pcall(function()
            while cfg.autoMerchantBuy do
                merchantWake = false
                fetchMerchantStock()

                if merchantBuyLock.Acquire() then
                    local ok, err = pcall(purchaseMerchantSelected, true)
                    merchantBuyLock.Release()
                    if not ok then
                        warn("[Merchant] auto buy error: " .. tostring(err))
                    end
                end

                autoWait(
                    function() return cfg.autoMerchantBuy end,
                    function(waited)
                        return (waited >= 0.5 and merchantWake)
                            or (waited >= 1 and merchantFetcher.Dirty)
                    end
                )
            end
        end)

        merchantAutoBusy = false
    end

    buildMerchantItemList()

    MerchantItemDropdown = MerchantTab:Dropdown({
        Title = "Items",
        Desc = "Select Merchant items to buy",
        Values = merchantItemNames,
        Multi = true, AllowNone = true, Value = {},
        Callback = function(values)
            table.clear(cfg.merchantItems)
            for _, displayName in ipairs(values or {}) do
                local key = merchantItemKeys[displayName] or getCleanMerchantName(displayName)
                if key then cfg.merchantItems[key] = true end
            end
        end
    })

    MerchantTab:Toggle({
        Title = "Auto Buy",
        Desc = "Automatically buys selected Merchant items",
        Value = cfg.autoMerchantBuy,
        Callback = function(value)
            cfg.autoMerchantBuy = value
            if value then task.spawn(merchantAutoLoop) end
        end
    })

    MerchantTab:Button({
        Title = "Manual Buy",
        Desc = "Buy selected Merchant items once",
        Callback = function()
            task.spawn(buyMerchantSelected)
        end
    })

    Workspace:GetAttributeChangedSignal("GlobalMerchantEvent"):Connect(function()
        merchantFetcher.MarkDirty()
        merchantWake = true
        requestMerchantRefresh(0.3)
        if cfg.autoMerchantBuy and not merchantAutoBusy then
            task.spawn(merchantAutoLoop)
        end
    end)

    if MerchantStockUpdated then
        MerchantStockUpdated.OnClientEvent:Connect(function()
            merchantFetcher.MarkDirty()
            requestMerchantRefresh(0.2)
        end)
    end

    requestMerchantRefresh(0.5)
end

