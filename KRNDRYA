    local function countOthers()
        local count = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then count += 1 end
        end
        return count
    end

    local function updateStatus()
        if not cfg.statusView then return end
        local text = countOthers() .. "/" .. limit .. " others (you are not counted)"
        pcall(function() cfg.statusView:SetDesc(text) end)
    end

    local function checkLimit()
        if not cfg.autoKick or cfg.triggered then return end
        local others = countOthers()
        if others < limit then return end
        cfg.triggered = true
        LocalPlayer:Kick("Server full: " .. others .. "/" .. limit .. " others (game max " .. Players.MaxPlayers .. ")")
    end

    local function kickOnJoin(newPlayer)
        if not cfg.kickAnyJoin or cfg.triggered then return end
