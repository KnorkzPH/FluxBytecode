do
    local ACTIVATE_COOLDOWN = 0.8
    local MAX_CHASE_TIME = 12

    local function panEnabled()
        return cfg.autoPan or cfg.autoPanV2
    end

    local function equipPan()
        local char, hum = getChar()
        if not char or not hum or hum.Health <= 0 then return nil end

        local pan = findPanTool()
        if not pan then return nil end

        if pan.Parent ~= char then
            pcall(function() hum:EquipTool(pan) end)

            local started = os.clock()
            while pan.Parent ~= char and os.clock() - started < 0.4 do
                task.wait()
            end
        end

        return pan.Parent == char and pan or nil
    end

    local function chaseStep(root, targetRoot)
        if cfg.autoPanV2 then
            local offset = math.max(cfg.panChaseOffset or 1.5, 0.5)
            local stepDist = cfg.panChaseStep or 8
            local vec = targetRoot.Position - root.Position
            local dist = vec.Magnitude

            if dist > offset then
                local moveDist = math.min(stepDist, dist - offset)
                local nextPos = root.Position + vec.Unit * moveDist
                root.CFrame = CFrame.lookAt(nextPos, targetRoot.Position)
            end
        else
            root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -1.8)
        end

        root.AssemblyLinearVelocity = Vector3.zero

        return (targetRoot.Position - root.Position).Magnitude
    end

    local function returnToCounter()
        local plot = getPlot()
        local counter = plot and plot:FindFirstChild("Counter")
        if not counter then return end

        local returnPart = counter:FindFirstChild("Comp", true)
            or (counter:IsA("BasePart") and counter)
            or counter:FindFirstChildWhichIsA("BasePart", true)

        if returnPart then
            tp(returnPart.CFrame * CFrame.new(0, 3, 0))
        end
    end

    task.spawn(function()
        local lastActivate = 0
        local chaseStart = setmetatable({}, { __mode = "k" })

        while true do
            if not panEnabled() or not Sched.pan then
                Sched.panWake:Wait()
                continue
            end

            local release = acquireJob("Pan")
            local didChase = false

            local ok, err = pcall(function()
                while panEnabled() and Sched.pan do
                    local char, hum, root = getChar()
                    if not (char and hum and root) or hum.Health <= 0 then break end

                    local npc = Sched.runaways[1]
                    if not npc then break end

                    local targetRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart

                    if not targetRoot or not targetRoot.Parent then
                        Sched.skipRunaway(npc, 2)
                        task.wait(0.05)
                    else
                        chaseStart[npc] = chaseStart[npc] or os.clock()

                        if os.clock() - chaseStart[npc] > MAX_CHASE_TIME then
                            Sched.skipRunaway(npc, 6)
                            chaseStart[npc] = nil
                        else
                            didChase = true

                            local pan = equipPan()
                            local dist = chaseStep(root, targetRoot)

                            if pan and dist <= 12 and os.clock() - lastActivate >= ACTIVATE_COOLDOWN then
                                lastActivate = os.clock()
                                pcall(function() pan:Activate() end)
                            end

                            task.wait(cfg.autoPanV2 and (cfg.panChaseDelay or 0.08) or 0.05)
                        end
                    end
                end

                if didChase then
                    if cfg.autoWash or cfg.main2AutoWash then
                        Sched.washFirstUntil = os.clock() + 8
                    end

                    local _, humanoid = getChar()

                    if humanoid then
                        pcall(function() humanoid:UnequipTools() end)
                    end

                    if cfg.autoPan and not cfg.autoPanV2 then
                        returnToCounter()
                    end
                end
            end)

            release()

            if not ok then
                warn("[AutoPan] " .. tostring(err))
                task.wait(0.5)
            end

            task.wait(0.05)
        end
    end)
end

