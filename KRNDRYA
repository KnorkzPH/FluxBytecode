do
    local PAN_NAMES = { pan = true, goldenpan = true, vippan = true }

    lowerText = function(s)
        return string.lower(tostring(s or ""))
    end

    Sched.isPanTool = function(tool)
        return tool ~= nil
            and tool:IsA("Tool")
            and PAN_NAMES[string.lower(tool.Name)] == true
    end

    local function scanForPan(container, wanted)
        if not container then return nil end

        for _, tool in ipairs(container:GetChildren()) do
            if Sched.isPanTool(tool) and (wanted == nil or string.lower(tool.Name) == wanted) then
                return tool
            end
        end

        return nil
    end

    findPanTool = function()
        local choice = cfg.panChoice

        if choice and choice ~= "Auto" then
            local wanted = string.lower(choice)
            local found = scanForPan(LocalPlayer.Character, wanted)
                or scanForPan(LocalPlayer:FindFirstChild("Backpack"), wanted)

            if found then return found end
        end

        return scanForPan(LocalPlayer.Character)
            or scanForPan(LocalPlayer:FindFirstChild("Backpack"))
    end

    local function othersWaiting(name)
        for waiterName, count in pairs(Sched.waiters) do
            if waiterName ~= name and count > 0 then
                return true
            end
        end
        return false
    end

    acquireJob = function(name)
        local token = { name = name }

        if name == "Pan" then
            local started = os.clock()

            while Sched.owner and Sched.owner.name ~= "Pan" and os.clock() - started < 0.5 do
                task.wait()
            end

            Sched.owner = token
        elseif name == "Candy" then
            local started = os.clock()

            while Sched.owner and not Sched.pan and os.clock() - started < 0.5 do
                task.wait()
            end

            if Sched.pan then
                return nil
            end

            Sched.owner = token
        else
            Sched.waiters[name] = (Sched.waiters[name] or 0) + 1
            local acquired = false

            while true do
                local jobFlag = name == "Garbage" and "autoGarbage"
                    or name == "CleanTrash" and "autoCleanTrash"
                    or name

                if Sched.blocked(jobFlag) then break end

                if not Sched.owner then
                    local courtesy = Sched.lastName == name
                        and othersWaiting(name)
                        and os.clock() - Sched.lastTime < 0.08

                    if not courtesy then
                        Sched.owner = token
                        acquired = true
                        break
                    end
                end

                task.wait(0.02)
            end

            Sched.waiters[name] = math.max((Sched.waiters[name] or 1) - 1, 0)

            if not acquired then
                return nil
            end
        end

        return function()
            if Sched.owner == token then
                Sched.owner = nil
            end
            Sched.lastName = name
            Sched.lastTime = os.clock()
        end
    end

    runJob = function(name, fn)
        local release = acquireJob(name)
        if not release then return false end

        local ok, err = pcall(fn)
        release()

        if not ok then
            warn("[" .. tostring(name) .. "] " .. tostring(err))
        end

        return ok
    end

    waitUnless = function(seconds, stopFn)
        local untilTime = os.clock() + (seconds or 0)

        repeat
            if stopFn and stopFn() then return false end
            task.wait(math.clamp(untilTime - os.clock(), 0, 0.03))
        until os.clock() >= untilTime

        return not (stopFn and stopFn())
    end

    tp = function(cframe)
        local _, _, rootPart = getChar()
        if not rootPart then return end
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
        rootPart.CFrame = cframe
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end

    local cachedPlot

    getPlot = function()
        if cachedPlot
            and cachedPlot.Parent
