    end

    getCash = function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local cash = ls and ls:FindFirstChild("Cash")
        return cash and cash.Value or 0
    end

    local pathCache = {}

    local function quantize(v)
        return string.format(
            "%d,%d,%d",
            math.floor(v.X / 4),
            math.floor(v.Y / 4),
            math.floor(v.Z / 4)
        )
    end

    local function buildWaypoints(fromPos, toPos)
        local yDiff = toPos.Y - fromPos.Y

        if math.abs(yDiff) > 4 then
            local key = quantize(fromPos) .. ">" .. quantize(toPos)
            local cached = pathCache[key]

            if not cached then
                local path = PathfindingService:CreatePath({
                    AgentRadius = 2.0,
                    AgentHeight = 5.0,
                    AgentCanJump = true,
                    WaypointSpacing = 4
                })

                local ok = pcall(function()
                    path:ComputeAsync(fromPos, toPos)
                end)

                if ok and path.Status == Enum.PathStatus.Success then
                    cached = {}

                    for _, wp in ipairs(path:GetWaypoints()) do
                        cached[#cached + 1] = wp.Position + Vector3.new(0, 1.6, 0)
                    end

                    pathCache[key] = cached
                end
            end

            if cached and #cached > 0 then
                local result = table.clone(cached)
                result[#result + 1] = toPos
                return result
            end
        end

        local result = {}

        if math.abs(yDiff) > 3 then
            result[1] = Vector3.new(fromPos.X, toPos.Y, fromPos.Z)
        end

        result[#result + 1] = toPos
        return result
    end

    flyTweenWaypoints = function(targetPos, stopFn, speedOverride)
        local char, hum, hrp = getChar()
        if not (char and hum and hrp) or hum.Health <= 0 then return false end

        local waypoints = buildWaypoints(hrp.Position, targetPos)

        local parts = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                parts[#parts + 1] = part
            end
        end

        local noclipConn = RunService.Stepped:Connect(function()
            for i = 1, #parts do
                parts[i].CanCollide = false
            end
        end)

        local speed = math.clamp(tonumber(speedOverride or cfg.tweenSpeed) or 26, 12, 60)
        local rotation = hrp.CFrame.Rotation
        local success = true

        for _, wp in ipairs(waypoints) do
            while true do
                if not (char.Parent and hrp.Parent) or hum.Health <= 0 or (stopFn and stopFn()) then
                    success = false
                    break
                end

                local offset = wp - hrp.Position
                local dist = offset.Magnitude

                if dist <= 0.35 then break end

                local dt = RunService.Heartbeat:Wait()
                local step = math.min(dist, speed * dt)

                hrp.CFrame = CFrame.new(hrp.Position + offset.Unit * step) * rotation
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end

            if not success then break end
        end

        noclipConn:Disconnect()

        if hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        return success
    end

    do
        local NPCDespawned = NPCRemotes:WaitForChild("NPCDespawned")
        local NPCRagdolled = Remotes:WaitForChild("NPCRagdolled")

        local wake = Instance.new("BindableEvent")
        Sched.panWake = wake.Event

        local pending = {}
        local valid = {}
        local models = {}
        local hooked = setmetatable({}, { __mode = "k" })

        local function refresh()
            local panOn = cfg.autoPan or cfg.autoPanV2
            local was = Sched.pan

            Sched.pan = (panOn and #Sched.runaways > 0 and findPanTool() ~= nil) == true

            if Sched.pan and not was then
                wake:Fire()
            end
        end

        Sched.refresh = refresh

        local function listAdd(model)
            if not table.find(Sched.runaways, model) then
                table.insert(Sched.runaways, model)
            end
        end

        local function listRemove(model)
            local i = table.find(Sched.runaways, model)
            if i then table.remove(Sched.runaways, i) end
        end

        local function activate(npcId, model)
            if valid[npcId] == model then return end
            valid[npcId] = model
            listAdd(model)
            refresh()
        end

        local function deactivate(npcId)
            local model = valid[npcId]
            valid[npcId] = nil
            pending[npcId] = nil
            if model then listRemove(model) end
            refresh()
        end

        Sched.skipRunaway = function(model, seconds)
            listRemove(model)
            refresh()

            task.delay(seconds or 2, function()
                if valid[model.Name] == model
                    and model.Parent
                    and model:GetAttribute("IsRunaway") == true then
                    listAdd(model)
                    refresh()
                end
            end)
        end

        local function isMineData(data)
            if data.PlotOwnerId == LocalPlayer.UserId then return true end

            local plot = data.Plot
            if typeof(plot) == "Instance" and plot:GetAttribute("Owner") == LocalPlayer.UserId then
                return true
            end

            local workPlot = LocalPlayer:GetAttribute("WorkPlot")
            local plotName = data.PlotName or (typeof(plot) == "Instance" and plot.Name) or nil

            return workPlot ~= nil and plotName == workPlot
        end

        local function isMineModel(model)
            local plotName = model:GetAttribute("NPCPlotName")
            if plotName == nil then return false end

            if plotName == LocalPlayer:GetAttribute("WorkPlot") then return true end

            local plot = getPlot()
            return plot ~= nil and plot.Name == plotName
        end

        local function evaluate(model)
            local id = model.Name

            if model:GetAttribute("IsRunaway") == true and (pending[id] ~= nil or isMineModel(model)) then
                activate(id, model)
            elseif valid[id] == model then
                deactivate(id)
            end
        end

        local function hookModel(model)
            if not model:IsA("Model") or hooked[model] then return end
            hooked[model] = true
            models[model.Name] = model

            model:GetAttributeChangedSignal("IsRunaway"):Connect(function()
                evaluate(model)
            end)

            model.AncestryChanged:Connect(function(_, parent)
                if parent then return end
                hooked[model] = nil
                if models[model.Name] == model then models[model.Name] = nil end
                if valid[model.Name] == model then deactivate(model.Name) end
            end)

            evaluate(model)
        end

        NPCDespawned.OnClientEvent:Connect(function(npcId, _list, isRunaway, runaway)
            if not isRunaway or type(runaway) ~= "table" then return end

            local id = runaway.NpcId or npcId
            if id == nil or not isMineData(runaway) then return end

            pending[id] = runaway

            local lifetime = (tonumber(runaway.ExpiresAt) or 0) - Workspace:GetServerTimeNow()
            task.delay(math.max(lifetime, 0) + 2, function()
                if pending[id] == runaway then pending[id] = nil end
            end)

            local model = models[id]
            if model then evaluate(model) end
        end)

        NPCRagdolled.OnClientEvent:Connect(function(npcId)
            deactivate(npcId)
        end)

        task.spawn(function()
            local folder = Workspace:WaitForChild("ClientNPCs", 60)
            if not folder then
                warn("[AutoPan] ClientNPCs folder not found")
                return
            end

            folder.ChildAdded:Connect(hookModel)

            for _, child in ipairs(folder:GetChildren()) do
                hookModel(child)
            end
        end)

        local function hookContainer(container)
            if not container then return end
            container.ChildAdded:Connect(refresh)
            container.ChildRemoved:Connect(refresh)
        end

        hookContainer(LocalPlayer.Character)
        hookContainer(LocalPlayer:FindFirstChild("Backpack"))

        LocalPlayer.CharacterAdded:Connect(function(character)
            hookContainer(character)

            task.spawn(function()
                hookContainer(LocalPlayer:WaitForChild("Backpack", 10))
                refresh()
            end)
        end)
    end
end

